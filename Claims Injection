def to_local_path(path: str) -> str:

    if path.startswith("dbfs:"):
        return path[len("dbfs:"):]

    return path


def sanitize_column_name(name: str):

    novo_nome = str(name).strip()

    novo_nome = re.sub(
        r"[ ,;{}()\n\t=]",
        "_",
        novo_nome
    )

    substituicoes = {
        "º": "o",
        "ª": "a",
        "%": "pct",
        "/": "_",
        "\\": "_",
        "#": "num",
        "€": "eur",
        "$": "usd"
    }

    for original, substituto in substituicoes.items():
        novo_nome = novo_nome.replace(
            original,
            substituto
        )

    novo_nome = re.sub(r"_+", "_", novo_nome)
    novo_nome = novo_nome.strip("_")

    if not novo_nome:
        novo_nome = "coluna_sem_nome"

    return novo_nome


def sanitize_dataframe_columns(df):

    nomes_originais = df.columns
    nomes_novos = []
    contador = {}

    for nome in nomes_originais:

        novo_nome = sanitize_column_name(nome)

        if novo_nome in contador:
            contador[novo_nome] += 1
            novo_nome = f"{novo_nome}_{contador[novo_nome]}"
        else:
            contador[novo_nome] = 0

        nomes_novos.append(novo_nome)

    for antigo, novo in zip(
        nomes_originais,
        nomes_novos
    ):

        if antigo != novo:
            df = df.withColumnRenamed(
                antigo,
                novo
            )

    return df


def cast_all_columns_to_string(df):

    for coluna in df.columns:

        df = df.withColumn(
            coluna,
            col(coluna).cast(StringType())
        )

    return df


def read_excel_robust(volume_path, file_name):

    local_path = to_local_path(volume_path)

    if not os.path.exists(local_path):
        raise Exception(
            f"Ficheiro não encontrado: {local_path}"
        )

    match = re.search(
        r"(\d{4})",
        file_name
    )

    if not match:
        raise Exception(
            f"Não foi possível identificar o ano em {file_name}"
        )

    ano = match.group(1)

    sheet_name = f"CLAIMS_{ano}"

    print(f"A ler sheet: {sheet_name}")

    excel = pd.ExcelFile(local_path)

    print(f"Sheets disponíveis: {excel.sheet_names}")

    if sheet_name not in excel.sheet_names:

        raise Exception(
            f"Sheet {sheet_name} não encontrada. "
            f"Sheets disponíveis: {excel.sheet_names}"
        )

    pdf = pd.read_excel(
        local_path,
        sheet_name=sheet_name,
        dtype=str
    )

    pdf = pdf.fillna("")

    pdf = pdf.dropna(
        axis=0,
        how="all"
    )

    pdf = pdf.dropna(
        axis=1,
        how="all"
    )

    print(f"Linhas lidas: {len(pdf):,}")
    print(f"Colunas lidas: {len(pdf.columns)}")

    if len(pdf) == 0:
        raise Exception(
            f"Sem registos na sheet {sheet_name}"
        )

    pdf.columns = [
        str(c).strip()
        for c in pdf.columns
    ]

    return spark.createDataFrame(
        pdf.astype(str)
    ), ano


