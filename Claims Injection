# -*- coding: utf-8 -*-
"""
PONTE DO LOSS RATIO — wrk_lr_bridge e wrk_lr_bridge_myb

- wrk_lr_bridge: ponte PY (ano anterior) vs CY.
  Se já existir com o esquema atual, não é alterada.
  Se tiver um esquema diferente, é reconstruída.
- wrk_lr_bridge_myb: ponte Budget vs CY.
  É reconstruída em cada execução.

METODOLOGIA DOS CÁLCULOS
------------------------
Os cálculos partem do LR TOTAL (com IBNR), porque o custo médio já inclui
o IBNR. Por isso não há efeito IBNR separado na ponte.

O LR total do período de referência e do CY aparece nas colunas
"LR LY (pp)" / "LR Budget (pp)" e "LR CY (pp)". O LR IBNR aparece apenas
como informação, em "LR IBNR LY (pp)" / "LR IBNR Budget (pp)" e
"LR IBNR CY (pp)", e não entra nos cálculos.

O prémio médio é por exposição, como a frequência:
    exposição = nº sinistros / frequência
    Prémio médio = Earned Premiums YTD / exposição

Cada efeito parte do LR total de referência (LR25 = LR_total_ref):

    Variação prémio médio = Prémio_CY / Prémio_ref - 1
    LR_a = LR25 / (1 + Variação prémio médio)
    Efeito prémio = LR_a - LR_total_ref

    Burning cost = Frequência x Custo médio
    LR_a = LR25 x (1 + Variação frequência) x (1 + Variação custo médio)
    Efeito burning cost = LR_a - LR_total_ref

"Outros" é o residual (inclui a interação entre prémio e burning cost,
já que cada efeito parte do LR de referência):

    Efeito outros = (LR_total_CY - LR_total_ref)
                    - Efeito prémio - Efeito burning cost

Logo, a reconciliação é:

    Efeito prémio + Efeito burning cost + Efeito outros
    = variação do LR total

Diagnóstico: k = LR total / (Frequência x Custo médio / Prémio médio),
nas colunas "k LY" / "k Budget" e "k CY". Se k for parecido nos dois
períodos, "Outros" fica perto de zero.

Os efeitos são multiplicados por LR_TO_PP para serem expressos em pp.
"""

from pyspark.sql import functions as F

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO
# ═══════════════════════════════════════════════════════════════════════════

TGT_CATALOG = "agpt_insurance_dv_catalog"
TGT_SCHEMA = "wkb_bus_operations_claimsmotor"

TGT_TABLE_RAW = "raw_claims_drivers_real_all"
TGT_TABLE_BRIDGE = "wrk_lr_bridge"
TGT_TABLE_BRIDGE_MYB = "wrk_lr_bridge_myb"

TABLE_RAW = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_RAW}"
TABLE_BRIDGE = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE}"
TABLE_BRIDGE_MYB = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE_MYB}"

# 100 se o Gross LR vem em fração (por exemplo, 0.554).
# 1 se já vem em percentagem (por exemplo, 55.4).
LR_TO_PP = 100


def col(name):
    """Referencia nomes de colunas com espaços ou caracteres especiais."""
    return F.col("`" + name.replace("`", "``") + "`")


def build_bridge(raw, comparison):
    """
    Constrói os efeitos da ponte CY vs período de comparação.

    comparison:
        "PY"     -> ano imediatamente anterior vs CY
        "BUDGET" -> Budget do mesmo ano vs CY
    """
    if comparison not in ("PY", "BUDGET"):
        raise ValueError("comparison tem de ser 'PY' ou 'BUDGET'.")

    period = F.upper(F.trim(col("period").cast("string")))
    year2 = F.substring(col("suk_month").cast("string"), 3, 2)
    period_year = F.regexp_extract(period, r"([0-9]{2})$", 1)

    is_month_period = period.rlike(r"^[0-9]{2} ")

    # PY é apenas o ano imediatamente anterior, não qualquer ano diferente.
    previous_year2 = F.lpad(
        F.pmod(
            year2.cast("int") - F.lit(1),
            F.lit(100),
        ).cast("string"),
        2,
        "0",
    )

    is_cy = is_month_period & (period_year == year2)
    is_py = is_month_period & (period_year == previous_year2)
    is_budget = period == F.concat(F.lit("B"), year2)

    period_out = (
        F.when(is_cy, F.lit("CY"))
        .when(is_py, F.lit("PY"))
        .when(is_budget, F.lit("BUDGET"))
    )

    # A frequência é por exposição (não por nº de apólices), por isso o prémio médio
    # também tem de ser por exposição: exposição = nº sinistros / frequência.
    #   Prémio médio = Earned Premiums YTD / exposição = Earned Premiums YTD x Frequência / nº sinistros
    # Assim Frequência x Custo médio / Prémio médio = Claims Charge / Earned Premiums.
    claims = col("# Claims of Total YTD").cast("double")
    frequency = col("Frequency of Total YTD").cast("double")

    base = raw.select(
        col("suk_month").cast("int").alias("suk_month"),
        col("brand_details"),
        period_out.alias("p"),

        # Valores de LR usados apenas nos cálculos internos.
        col("Gross LR Total cy").cast("double").alias("lr_total"),
        col("Gross LR IBNR").cast("double").alias("ibnr"),

        col("Frequency of Total YTD").cast("double").alias("fr"),
        col("Average Cost (€) of Total YTD").cast("double").alias("cm"),

        F.when(
            (claims != 0) & frequency.isNotNull(),
            col("Earned Premiums YTD").cast("double") * frequency / claims,
        ).alias("pm"),
    ).where(F.col("p").isNotNull())

    comparison_period = "PY" if comparison == "PY" else "BUDGET"
    comparison_label = "PY" if comparison == "PY" else "Budget"

    reference = base.where(F.col("p") == comparison_period).drop("p")
    cy = base.where(F.col("p") == "CY").drop("p")

    for name in ("lr_total", "ibnr", "fr", "cm", "pm"):
        reference = reference.withColumnRenamed(name, name + "0")
        cy = cy.withColumnRenamed(name, name + "1")

    joined = reference.join(
        cy,
        ["suk_month", "brand_details"],
        "inner",
    )

    # Base dos cálculos: LR total (o custo médio já inclui o IBNR).
    lr0 = F.col("lr_total0")
    lr1 = F.col("lr_total1")

    valid_factors = (
        F.col("pm0").isNotNull()
        & F.col("pm1").isNotNull()
        & F.col("cm0").isNotNull()
        & F.col("cm1").isNotNull()
        & F.col("fr0").isNotNull()
        & F.col("fr1").isNotNull()
        & (F.col("pm1") != 0)
        & (F.col("cm0") != 0)
        & (F.col("fr0") != 0)
    )

    # Variações face à referência.
    var_premio = F.col("pm1") / F.col("pm0") - 1
    var_freq = F.col("fr1") / F.col("fr0") - 1
    var_custo = F.col("cm1") / F.col("cm0") - 1

    # Efeito prémio: LR_a = LR25 / (1 + variação prémio médio).
    lr_a_premio = F.when(valid_factors, lr0 / (1 + var_premio))
    # Efeito burning cost: LR_a = LR25 x (1 + variação frequência) x (1 + variação custo médio).
    lr_a_burning = F.when(
        valid_factors,
        lr0 * (1 + var_freq) * (1 + var_custo),
    )

    # Diagnóstico do "Outros": k = LR total / (Frequência x Custo médio / Prémio médio).
    # Se k for parecido na referência e no CY, "Outros" fica perto de zero.
    def k_factor(lr_ex, fr, cm, pm):
        model = fr * cm / pm
        return F.when(
            fr.isNotNull() & cm.isNotNull() & pm.isNotNull() & (pm != 0) & (model != 0),
            lr_ex / model,
        )

    k_ref = k_factor(lr0, F.col("fr0"), F.col("cm0"), F.col("pm0"))
    k_cy = k_factor(lr1, F.col("fr1"), F.col("cm1"), F.col("pm1"))

    scale = F.lit(float(LR_TO_PP))

    efeito_premio = (lr_a_premio - lr0) * scale
    efeito_burning = (lr_a_burning - lr0) * scale

    # Residual necessário para reconciliar a variação do LR total.
    efeito_outros = (lr1 - lr0) * scale - efeito_premio - efeito_burning

    # LR de referência e CY, contribuições da ponte e fatores usados.
    return joined.select(
        "suk_month",
        "brand_details",

        (F.col("lr_total0") * scale).alias("LR LY (pp)" if comparison == "PY" else "LR Budget (pp)"),
        (F.col("lr_total1") * scale).alias("LR CY (pp)"),
        (F.col("ibnr0") * scale).alias(
            "LR IBNR LY (pp)" if comparison == "PY" else "LR IBNR Budget (pp)"
        ),
        (F.col("ibnr1") * scale).alias("LR IBNR CY (pp)"),

        efeito_premio.alias("Efeito prémio médio (pp)"),
        efeito_burning.alias("Efeito burning cost (pp)"),
        efeito_outros.alias("Efeito outros (pp)"),

        F.col("pm0").alias(f"Prémio médio {comparison_label}"),
        F.col("pm1").alias("Prémio médio CY"),
        F.col("cm0").alias(f"Custo médio {comparison_label}"),
        F.col("cm1").alias("Custo médio CY"),
        F.col("fr0").alias(f"Frequência {comparison_label}"),
        F.col("fr1").alias("Frequência CY"),

        k_ref.alias("k LY" if comparison == "PY" else "k Budget"),
        k_cy.alias("k CY"),
    )


def write_bridge(spark, sdf, table_name):
    """Cria ou substitui uma tabela Delta com os dados da ponte."""

    def quote_identifier(name):
        return "`" + name.replace("`", "``") + "`"

    spark.sql(f"DROP TABLE IF EXISTS {table_name}")

    column_types = {
        "suk_month": "INT",
        "brand_details": "STRING",
    }

    ddl_columns = ", ".join(
        f"{quote_identifier(name)} {column_types.get(name, 'DOUBLE')}"
        for name in sdf.columns
    )

    spark.sql(
        f"CREATE TABLE {table_name} ({ddl_columns}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )

    sdf.write.format("delta").mode("append").saveAsTable(table_name)
    print(f"{sdf.count()} linhas inseridas em {table_name}")


def run_bridge(spark):
    if not spark.catalog.tableExists(TABLE_RAW):
        raise ValueError(f"Tabela raw não encontrada: {TABLE_RAW}")

    raw = spark.table(TABLE_RAW)

    # Cria a ponte PY se ainda não existir. Se existir com colunas antigas
    # de LR, reconstrói-a para aplicar o esquema atual sem colunas de LR.
    py_bridge = build_bridge(raw, "PY")
    expected_py_columns = py_bridge.columns

    if not spark.catalog.tableExists(TABLE_BRIDGE):
        write_bridge(spark, py_bridge, TABLE_BRIDGE)
    else:
        existing_py_columns = spark.table(TABLE_BRIDGE).columns

        if existing_py_columns != expected_py_columns:
            print(
                "O esquema existente de wrk_lr_bridge é diferente "
                "do esquema atual; a tabela será reconstruída."
            )
            write_bridge(spark, py_bridge, TABLE_BRIDGE)
        else:
            print(
                "A tabela existente foi mantida sem alterações: "
                f"{TABLE_BRIDGE}"
            )

    # Reconstrói a ponte Budget vs CY em cada execução.
    budget_bridge = build_bridge(raw, "BUDGET")
    write_bridge(spark, budget_bridge, TABLE_BRIDGE_MYB)


if "spark" in globals():  # Só corre dentro do Databricks.
    run_bridge(spark)
