# CORE CLAIMS DRIVERS INFLOWS BUDGET
# ═══════════════════════════════════════════════════════════════════════════

from pyspark.sql import functions as F

TABLE_RAW_BUDGET = (
    "agpt_insurance_dv_catalog."
    "wkb_bus_operations_claimsmotor."
    "raw_claims_drivers_budget_all"
)

TABLE_INFLOWS_BUDGET = (
    "agpt_insurance_dv_catalog."
    "wkb_bus_operations_claimsmotor."
    "core_claims_drivers_inflows_budget_all"
)


def build_inflows_budget(raw):

    inflows = F.col("Inflows YTD").cast("double")
    earned = F.col("Earned Premiums YTD").cast("double")
    portfolio = F.col("Portfolio").cast("double")

    avg_inflows = F.when(
        portfolio != 0,
        inflows / portfolio
    )

    avg_earned = F.when(
        portfolio != 0,
        earned / portfolio
    )

    ratio = F.when(
        avg_inflows != 0,
        avg_earned / avg_inflows
    )

    return raw.select(

        F.col("suk_month").cast("int").alias("suk_month"),
        F.col("brand"),

        inflows.alias("Inflows YTD"),
        portfolio.alias("Portfolio"),
        earned.alias("Earned Premiums YTD"),

        avg_inflows.alias("Average Premium Inflows"),
        avg_earned.alias("Average Premium Earned"),
        ratio.alias("Earned Premium / Inflows"),

        F.col("# Claims of Total YTD").cast("double")
            .alias("# Claims Total YTD"),

        F.col("# Claims of Large Claims YTD").cast("double")
            .alias("# Claims Large Claims YTD"),

        F.col("# Claims of Attritional YTD").cast("double")
            .alias("# Claims Attritional YTD"),

        F.col("Claims Charge of Total YTD").cast("double")
            .alias("Claims Charge cy YTD"),

        F.col("Claims Charge of Large Claims YTD").cast("double")
            .alias("Claims Charge Large Claims YTD"),

        F.col("Claims Charge of Attritional YTD").cast("double")
            .alias("Claims Charge Attritional YTD"),

        F.col("Claims Charge of IBNR YTD").cast("double")
            .alias("Claims Charge IBNR YTD"),

        F.col("Claims Charge of IBNER YTD").cast("double")
            .alias("Claims Charge IBNER YTD"),

        F.col("Claims Charge of IBNR/IBNER YTD").cast("double")
            .alias("Claims Charge IBNR/IBNER YTD"),

        F.col("Gross LR CY f/f").cast("double")
            .alias("Gross LR CY f/f"),

        F.col("Gross LR Total cy").cast("double")
            .alias("Gross LR Total cy"),

        F.col("Gross LR Total py").cast("double")
            .alias("Gross LR Total py"),

        F.col("Gross LR Total ay").cast("double")
            .alias("Gross LR Total ay"),

        F.col("Gross LR IBNR").cast("double")
            .alias("Gross LR IBNR"),

        F.col("Gross LR IBNER").cast("double")
            .alias("Gross LR IBNER"),

        F.col("Gross LR IBNR/IBNER").cast("double")
            .alias("Gross LR IBNR/IBNER")

    )


df = build_inflows_budget(
    spark.table(TABLE_RAW_BUDGET)
)

spark.sql(f"DROP TABLE IF EXISTS {TABLE_INFLOWS_BUDGET}")

spark.sql(f"""
CREATE TABLE {TABLE_INFLOWS_BUDGET}
(
    `suk_month` INT,
    `brand` STRING,

    `Inflows YTD` DOUBLE,
    `Portfolio` DOUBLE,
    `Earned Premiums YTD` DOUBLE,

    `Average Premium Inflows` DOUBLE,
    `Average Premium Earned` DOUBLE,
    `Earned Premium / Inflows` DOUBLE,

    `# Claims Total YTD` DOUBLE,
    `# Claims Large Claims YTD` DOUBLE,
    `# Claims Attritional YTD` DOUBLE,

    `Claims Charge cy YTD` DOUBLE,
    `Claims Charge Large Claims YTD` DOUBLE,
    `Claims Charge Attritional YTD` DOUBLE,

    `Claims Charge IBNR YTD` DOUBLE,
    `Claims Charge IBNER YTD` DOUBLE,
    `Claims Charge IBNR/IBNER YTD` DOUBLE,

    `Gross LR CY f/f` DOUBLE,
    `Gross LR Total cy` DOUBLE,
    `Gross LR Total py` DOUBLE,
    `Gross LR Total ay` DOUBLE,
    `Gross LR IBNR` DOUBLE,
    `Gross LR IBNER` DOUBLE,
    `Gross LR IBNR/IBNER` DOUBLE
)
USING DELTA
TBLPROPERTIES (
    'delta.columnMapping.mode' = 'name',
    'delta.minReaderVersion' = '2',
    'delta.minWriterVersion' = '5'
)
""")

(
    df.write
      .format("delta")
      .mode("append")
      .saveAsTable(TABLE_INFLOWS_BUDGET)
)

print(
    f"{df.count()} linhas carregadas em {TABLE_INFLOWS_BUDGET}"
)
