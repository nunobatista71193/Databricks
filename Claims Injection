import re
import datetime as dt
import tempfile

from openpyxl import load_workbook
from openpyxl.utils import column_index_from_string


# ============================================================================
# CONFIGURAÇÃO
# ============================================================================

EXCEL_FILE = "/Volumes/agpt_insurance_dv_catalog/wkb_bus_operations_claimsmotor/pba&uw/01_raw/budget/Claims drivers - budget 2026_mes.xlsx"

TARGET_TABLE = (
    "agpt_insurance_dv_catalog."
    "wkb_bus_operations_claimsmotor."
    "raw_claims_drivers_budget_all"
)

LABEL_COL = "D"
FIRST_MONTH_COL = "AE"
LAST_MONTH_COL = "AP"

HEADER_ROW = 3
FIRST_DATA_ROW = 4

SHEET_TO_BRAND = {
    "Motor ags ND": "AGS ND",
    "Motor sd": "SD",
    "Motor ocs": "OCS",
    "Motor all": "Non Life"
}

SKIP_EMPTY_MONTHS = True

YTD_ROWS = {"inflows", "earned premiums"}
YTD_SUFFIX = " YTD"
YTD_FACTOR = 1000


# ============================================================================
# AUXILIARES
# ============================================================================

_MONTHS = {
    "jan": 1, "fev": 2, "feb": 2,
    "mar": 3,
    "abr": 4, "apr": 4,
    "mai": 5, "may": 5,
    "jun": 6,
    "jul": 7,
    "ago": 8, "aug": 8,
    "set": 9, "sep": 9,
    "out": 10, "oct": 10,
    "nov": 11,
    "dez": 12, "dec": 12
}

SIMPLE_ROWS = {
    "portfolio",
    "portfólio",
    "inflows",
    "earned premiums"
}

CLAIMS_MONTH_RE = re.compile(r"^#\s*claims\s*month$", re.I)

BLOCK_METRICS = {
    "# claims",
    "frequency",
    "average cost (€)",
    "claims charge"
}


def norm(v):
    return re.sub(r"\s+", " ", str(v)).strip() if v is not None else ""


def to_number(v):

    if v is None:
        return None

    if isinstance(v, (int, float)):
        return float(v)

    try:
        return float(
            str(v)
            .replace(" ", "")
            .replace(",", ".")
        )
    except:
        return None


def to_suk_month(v):

    if isinstance(v, (dt.date, dt.datetime)):
        return int(v.year * 100 + v.month)

    m = re.match(
        r"^\s*([A-Za-zçÇ]{3})[a-z]*[\s/\-.]+(\d{2}|\d{4})\s*$",
        str(v)
    )

    if not m:
        raise ValueError(f"Mês inválido: {v}")

    month = _MONTHS[m.group(1).lower()]
    year = int(m.group(2))

    if year < 100:
        year += 2000

    return year * 100 + month


# ============================================================================
# LEITURA DAS LINHAS
# ============================================================================

def select_rows(ws):

    lc = column_index_from_string(LABEL_COL)

    labels = {
        r: norm(ws.cell(r, lc).value)
        for r in range(FIRST_DATA_ROW, ws.max_row + 1)
    }

    def key(label):
        return re.sub(r"^#\s*", "# ", label.lower())

    def section_of(row):

        for r in range(row - 1, FIRST_DATA_ROW - 1, -1):

            lab = labels.get(r, "")

            if (
                lab
                and key(lab) not in BLOCK_METRICS | {"# claims month"}
                and not lab.lower().startswith("gross lr")
            ):
                return lab

        return ""

    picked = []
    gross = []

    for r, lab in labels.items():

        if not lab:
            continue

        low = lab.lower()

        if low in YTD_ROWS:

            picked.append((lab + YTD_SUFFIX, r))

        elif low in SIMPLE_ROWS or "ytd" in low:

            picked.append((lab, r))

        elif CLAIMS_MONTH_RE.match(lab):

            picked.append(
                (
                    f"# Claims Month of {labels.get(r-2,'')}",
                    r
                )
            )

        elif key(lab) in BLOCK_METRICS:

            picked.append(
                (
                    f"{lab} of {section_of(r)}{YTD_SUFFIX}",
                    r
                )
            )

        elif low.startswith("gross lr"):

            gross.append((lab, r))

    counts = {}

    for lab, _ in gross:
        counts[lab] = counts.get(lab, 0) + 1

    for lab, r in gross:

        picked.append(
            (
                f"{lab} of {section_of(r)}"
                if counts[lab] > 1
                else lab,
                r
            )
        )

    cols = {}

    for name, r in picked:
        cols[name] = r

    return cols


# ============================================================================
# SHEETS
# ============================================================================

def parse_sheet(ws, brand):

    rows = select_rows(ws)

    c1 = column_index_from_string(FIRST_MONTH_COL)
    c2 = column_index_from_string(LAST_MONTH_COL)

    output = []

    for c in range(c1, c2 + 1):

        header = ws.cell(HEADER_ROW, c).value

        if header is None:
            continue

        rec = {
            "brand": brand,
            "suk_month": to_suk_month(header)
        }

        for name, row_nr in rows.items():

            val = to_number(
                ws.cell(row_nr, c).value
            )

            if (
                val is not None
                and name.endswith(YTD_SUFFIX)
                and name[:-len(YTD_SUFFIX)].lower() in YTD_ROWS
            ):
                val *= YTD_FACTOR

            rec[name] = val

        if SKIP_EMPTY_MONTHS:

            if all(
                rec[col] is None
                for col in rows
            ):
                continue

        output.append(rec)

    return output, list(rows.keys())


# ============================================================================
# READ EXCEL
# ============================================================================

def read_workbook():

    tmp_file = "/tmp/claims_budget.xlsx"

    try:
        dbutils.fs.rm(f"file:{tmp_file}")
    except:
        pass

    dbutils.fs.cp(
        f"dbfs:{EXCEL_FILE}",
        f"file:{tmp_file}"
    )

    wb = load_workbook(
        tmp_file,
        data_only=True
    )

    result = {}

    for sheet_name, brand in SHEET_TO_BRAND.items():

        ws = wb[sheet_name]

        result[brand] = parse_sheet(
            ws,
            brand
        )

    wb.close()

    return result


# ============================================================================
# GRAVAR EM DELTA
# ============================================================================

def write_to_delta(parsed):

    from pyspark.sql import types as T

    cols = []

    for _, (_, c) in parsed.items():

        for x in c:
            if x not in cols:
                cols.append(x)

    schema = T.StructType(
        [
            T.StructField("brand", T.StringType()),
            T.StructField("suk_month", T.IntegerType())
        ]
        +
        [
            T.StructField(c, T.DoubleType())
            for c in cols
        ]
    )

    rows = []

    for recs, _ in parsed.values():

        for r in recs:

            rows.append(
                [r["brand"], r["suk_month"]]
                + [r.get(c) for c in cols]
            )

    sdf = spark.createDataFrame(
        rows,
        schema
    )

    spark.sql(
        f"DROP TABLE IF EXISTS {TARGET_TABLE}"
    )

    (
        sdf.write
        .format("delta")
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(TARGET_TABLE)
    )

    print(
        f"{sdf.count()} linhas carregadas em {TARGET_TABLE}"
    )


# ============================================================================
# EXECUÇÃO
# ============================================================================

parsed = read_workbook()

for brand, (rows, cols) in parsed.items():
    print(f"{brand}: {len(rows)} meses, {len(cols)} métricas")

write_to_delta(parsed)

print("Fim.")
