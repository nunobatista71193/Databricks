def to_local_path(path: str) -> str:
    return path[len("dbfs:"):] if path.startswith("dbfs:") else path


def sanitize_column_name(name) -> str:
    n = str(name)

    # Excel codifica caracteres especiais como _xHHHH_ (ex.: _x0020_ = espaço)
    n = re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m.group(1), 16)), n)

    # remover acentos
    n = unicodedata.normalize("NFKD", n)
    n = "".join(c for c in n if not unicodedata.combining(c))

    for original, substituto in {
        "º": "o", "ª": "a", "%": "pct", "#": "num",
        "€": "eur", "$": "usd", "&": "e", "@": "at",
    }.items():
        n = n.replace(original, substituto)

    n = re.sub(r"[^0-9A-Za-z_]", "_", n)
    n = re.sub(r"_+", "_", n).strip("_")

    if not n:
        n = "coluna_sem_nome"
    if n[0].isdigit():
        n = f"c_{n}"

    return n.lower()


def sanitize_pandas_columns(pdf: pd.DataFrame) -> pd.DataFrame:
    vistos = {}
    novos = []

    for c in pdf.columns:
        n = sanitize_column_name(c)
        if n in vistos:
            vistos[n] += 1
            n = f"{n}_{vistos[n]}"
        else:
            vistos[n] = 0
        novos.append(n)

    pdf.columns = novos
    return pdf


def detect_file_kind(local_path: str) -> str:
    """Identifica o tipo real do ficheiro pelos primeiros bytes."""
    with open(local_path, "rb") as f:
        head = f.read(512)

    if head.startswith(b"PK\x03\x04"):
        return "xlsx"          # zip (xlsx / xlsm / xlsb)
    if head.startswith(b"\xd0\xcf\x11\xe0"):
        return "xls_or_encrypted"   # xls antigo OU xlsx com password
    low = head.lower()
    if b"<html" in low or b"<table" in low or b"<?xml" in low:
        return "html_xml"
    return "text"              # provavelmente CSV renomeado


def find_header_row(local_path, sheet_name, max_scan=30):
    """Primeira linha com >=50% das células preenchidas = cabeçalho."""
    head = pd.read_excel(
        local_path, sheet_name=sheet_name, header=None,
        nrows=max_scan, dtype=str, engine="calamine",
    )
    minimo = max(2, int(head.shape[1] * 0.5))
    for i, row in head.iterrows():
        if row.notna().sum() >= minimo:
            return i
    return 0


def read_text_fallback(local_path):
    """Ficheiro 'xlsx' que afinal é CSV/TSV: tenta várias codificações."""
    for enc in ("utf-8-sig", "utf-16", "cp1252", "latin-1"):
        try:
            return pd.read_csv(
                local_path, sep=None, engine="python",
                dtype=str, encoding=enc,
            )
        except Exception:
            continue
    raise Exception("Não foi possível ler o ficheiro como texto/CSV.")


def read_excel_robust(volume_path, file_name):
    local_path = to_local_path(volume_path)

    if not os.path.exists(local_path):
        raise Exception(f"Ficheiro não encontrado: {local_path}")

    match = re.search(r"(\d{4})", file_name)
    if not match:
        raise Exception(f"Não foi possível identificar o ano em {file_name}")
    ano = match.group(1)
    sheet_name = f"CLAIMS_{ano}"

    kind = detect_file_kind(local_path)
    print(f"Tipo detetado: {kind}")

    if kind == "xls_or_encrypted":
        # tenta como xls; se falhar, provavelmente tem password
        try:
            pd.ExcelFile(local_path, engine="calamine")
        except Exception:
            raise Exception(
                f"{file_name} parece protegido com password ou em formato não suportado."
            )

    if kind in ("html_xml",):
        raise Exception(
            f"{file_name} não é um Excel real (HTML/XML renomeado). "
            "Volta a exportar como .xlsx."
        )

    if kind == "text":
        print("Aviso: ficheiro é texto/CSV com extensão .xlsx, a ler como CSV.")
        pdf = read_text_fallback(local_path)
    else:
        sheets = pd.ExcelFile(local_path, engine="calamine").sheet_names
        print(f"Sheets disponíveis: {sheets}")

        if sheet_name not in sheets:
            raise Exception(f"Sheet {sheet_name} não encontrada. Disponíveis: {sheets}")

        hdr = find_header_row(local_path, sheet_name)
        print(f"Cabeçalho na linha {hdr}")

        pdf = pd.read_excel(
            local_path, sheet_name=sheet_name, header=hdr,
            dtype=str, engine="calamine",
        )

    pdf = pdf.dropna(axis=0, how="all").dropna(axis=1, how="all")
    if pdf.empty:
        raise Exception(f"Sem registos em {file_name}")

    pdf = sanitize_pandas_columns(pdf)
    pdf = pdf.astype(object).where(pdf.notna(), None)

    print(f"Linhas: {len(pdf):,} | Colunas: {len(pdf.columns)}")
    print(f"Primeiras colunas: {list(pdf.columns)[:10]}")

    # Sanidade: se só há 1 coluna, algo está errado -> parar cedo
    if len(pdf.columns) < 2:
        raise Exception(
            f"{file_name}: apenas {len(pdf.columns)} coluna lida "
            f"({list(pdf.columns)}). Ficheiro com formato inesperado."
        )

    return pdf, ano


def table_exists() -> bool:
    return spark.catalog.tableExists(full_table_name)


def write_chunk(pdf_chunk, file_name, ano, write_mode):
    schema = StructType([StructField(c, StringType(), True) for c in pdf_chunk.columns])
    sdf = spark.createDataFrame(pdf_chunk, schema=schema)

    sdf = (
        sdf
        .withColumn("source_file", lit(file_name))
        .withColumn("claim_year", lit(ano))
        .withColumn("file_type", lit("CLAIMS"))
        .withColumn("load_timestamp", current_timestamp())
    )

    writer = sdf.write.format("delta").mode(write_mode)

    if write_mode == "overwrite":
        writer = writer.option("overwriteSchema", "true")
    else:
        writer = writer.option("mergeSchema", "true")

    writer.saveAsTable(full_table_name)


