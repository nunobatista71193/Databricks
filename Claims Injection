def norm(v):
    """Texto limpo: sem espaços repetidos nem nas pontas."""
    return re.sub(r"\s+", " ", str(v)).strip() if v is not None else ""


def to_number(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    try:
        return float(str(v).replace(" ", "").replace(" ", "").replace(",", "."))
    except ValueError:
        return None  # #DIV/0!, #N/A, texto...


def _key(label):
    return re.sub(r"^#\s*", "# ", label.lower())


def reference_month(fname):
    """(ano, mês) de um ficheiro: OVERRIDES se existir, senão deduz do nome."""
    if fname in OVERRIDES:
        return int(OVERRIDES[fname][0]), int(OVERRIDES[fname][1])
    low = fname.lower()
    years = set(re.findall(r"(?<!\d)(20\d{2})(?!\d)", low))
    months = {_MONTH_NAMES[t] for t in re.findall(r"[a-zçã]+", low) if t in _MONTH_NAMES}
    if len(years) != 1 or len(months) != 1:
        raise ValueError(f"não consegui deduzir ano/mês (anos {sorted(years)}, meses {sorted(months)}); usa OVERRIDES")
    return int(years.pop()), months.pop()


def build_plan():
    """[(ficheiro, ano, mês)] ordenado por mês; falha se houver nomes ambíguos ou meses repetidos."""
    if SRC_FILES:
        names = list(SRC_FILES)
    else:
        names = sorted(f for f in os.listdir(SRC_DIR) if f.lower().endswith(".xlsx") and not f.startswith("~$"))
    plan, errors = [], []
    for f in names:
        try:
            y, m = reference_month(f)
            plan.append((f, y, m))
        except ValueError as e:
            errors.append(f"{f}: {e}")
    seen = {}
    for f, y, m in plan:
        seen.setdefault((y, m), []).append(f)
    errors += [f"{y}-{m:02d} repetido em: {', '.join(fs)}" for (y, m), fs in seen.items() if len(fs) > 1]
    if errors:
        raise ValueError("Problemas nos nomes dos ficheiros:\n  " + "\n  ".join(errors))
    return sorted(plan, key=lambda x: (x[1], x[2]))


def get_sheet(wb):
    actual = {n.strip().lower(): n for n in wb.sheetnames}
    if SHEET_NAME.strip().lower() not in actual:
        raise ValueError(f"Sheet '{SHEET_NAME}' não encontrada. Existentes: {wb.sheetnames}")
    return wb[actual[SHEET_NAME.strip().lower()]]


def period_columns(year, month):
    """[(índice_da_coluna, período)] segundo PERIOD_BLOCKS."""
    yy = year % 100
    f = dict(yy=f"{yy:02d}", y1=f"{(yy - 1) % 100:02d}", y2=f"{(yy - 2) % 100:02d}",
             y3=f"{(yy - 3) % 100:02d}", mm=f"{month:02d}")
    out = []
    for first, last, fmt in PERIOD_BLOCKS:
        for c in range(column_index_from_string(first), column_index_from_string(last) + 1):
            out.append((c, fmt.format(**f)))
    return out


def period_label(period, suk_month):
    """FY.. e B.. ficam como estão; "MM YY" passa a CY (ano do ficheiro) ou PY (ano anterior)."""
    if "FY" in period or "B" in period:
        return period
    return "CY" if period[-2:] == f"{(suk_month // 100) % 100:02d}" else "PY"


def upsert_month(spark, table, fields, rows, suk_month):
    """Cria a tabela se não existir, acrescenta colunas novas, apaga o mês e insere de novo.
    Os outros meses ficam intactos, por isso podes carregar um ficheiro de cada vez."""
    from pyspark.sql import types as T

    def q(c):  # nome de coluna entre backticks
        return "`" + c.replace("`", "``") + "`"

    tmap = {"STRING": T.StringType(), "INT": T.IntegerType(), "DOUBLE": T.DoubleType()}
    schema = T.StructType([T.StructField(n, tmap[t]) for n, t in fields])
    sdf = spark.createDataFrame(rows, schema=schema)

    # Nomes com espaços, '#', ',' ... exigem column mapping: define-se na própria tabela
    # (funciona também em serverless, onde não se podem alterar configs do Spark).
    ddl_cols = ", ".join(f"{q(n)} {t}" for n, t in fields)
    spark.sql(
        f"CREATE TABLE IF NOT EXISTS {table} ({ddl_cols}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )
    existing = {c.lower() for c in spark.table(table).columns}
    new_cols = [(n, t) for n, t in fields if n.lower() not in existing]
    if new_cols:
        spark.sql(f"ALTER TABLE {table} ADD COLUMNS (" + ", ".join(f"{q(n)} {t}" for n, t in new_cols) + ")")

    spark.sql(f"DELETE FROM {table} WHERE suk_month = {int(suk_month)}")
    sdf.write.format("delta").mode("append").saveAsTable(table)
    print(f"{sdf.count()} linhas inseridas em {table} (suk_month = {suk_month})")


# ═══════════════════════════════════════════════════════════════════════════
# PARTE 1 — RAW (todas as métricas em colunas)
#   brand_details = linha 3 | period = bloco de colunas | métricas = linhas da coluna B:
#   Portfolio, Inflows YTD / Earned Premiums YTD (x 1000), "<linha> of <bloco> YTD",
#   "# Claims Month of <bloco>", Gross LR *, e as EXTRA_ROWS (ex.: Claims Charge py, Average Cost (€) f/f)
# ═══════════════════════════════════════════════════════════════════════════
def select_rows(ws):
    """Devolve {nome_da_coluna: nº_da_linha} para as linhas a incorporar na raw."""
    lc = column_index_from_string(LABEL_COL)
    labels = {r: norm(ws.cell(r, lc).value) for r in range(FIRST_DATA_ROW, ws.max_row + 1)}

    def section_of(row):
        # bloco = primeira linha acima que não é uma métrica do bloco nem um Gross LR
        # (ex.: "# Claims" na linha 11 -> bloco "Crash, Collision or Rollover" na linha 10)
        for r in range(row - 1, FIRST_DATA_ROW - 1, -1):
            lab = labels.get(r, "")
            if lab and _key(lab) not in BLOCK_METRICS | {"# claims month"} and not lab.lower().startswith("gross lr"):
                return lab
        return ""

    picked, gross = [], []
    for r, lab in labels.items():
        if not lab:
            continue
        low = lab.lower()
        if low in YTD_ROWS:
            picked.append((lab + YTD_SUFFIX, r))
        elif low in EXTRA_ROWS:
            picked.append((EXTRA_ROWS[low], r))
        elif low in SIMPLE_ROWS or "ytd" in low:
            picked.append((lab, r))
        elif CLAIMS_MONTH_RE.match(lab):
            picked.append((f"# Claims Month of {labels.get(r - 2, '')}".strip(), r))
        elif _key(lab) in BLOCK_METRICS:
            picked.append((f"{lab} of {section_of(r)}{YTD_SUFFIX}", r))
        elif low.startswith("gross lr"):
            gross.append((lab, r))

    # Gross LR*: nome repetido entre blocos -> desambigua com o nome do bloco
    counts = {}
    for lab, _ in gross:
        counts[lab] = counts.get(lab, 0) + 1
    for lab, r in gross:
        picked.append((f"{lab} of {section_of(r)}" if counts[lab] > 1 else lab, r))

    cols = {}
    for name, r in sorted(picked, key=lambda x: x[1]):
        if name in cols:
            raise ValueError(f"Nome de coluna duplicado '{name}' (linhas {cols[name]} e {r})")
        cols[name] = r
    return cols


def parse_raw(ws, year, month):
    """Sheet -> (lista de dicts: 1 por coluna de dados, métricas em colunas; nomes das métricas)."""
    rows = select_rows(ws)
    suk_month = year * 100 + month
    out = []
    for c, period in period_columns(year, month):
        brand = norm(ws.cell(HEADER_ROW, c).value)
        if not brand:
            continue
        rec = {"suk_month": suk_month, "brand_details": BRAND_MAP.get(brand, brand), "period": period}
        for name, r in rows.items():
            val = to_number(ws.cell(r, c).value)
            if val is not None and (
                (name.endswith(YTD_SUFFIX) and name[:-len(YTD_SUFFIX)].lower() in YTD_ROWS)
                or name.lower().startswith("claims charge")   # Claims Charge também ×1000
            ):
                val = val * YTD_FACTOR
            rec[name] = val
        if SKIP_EMPTY_MONTHS and all(rec[n] is None for n in rows):
            continue
        out.append(rec)
    return out, list(rows)


def run_raw(spark, recs, cols, year, month):
    suk_month = year * 100 + month
    print(f"[1 raw] suk_month = {suk_month}: {len(recs)} colunas de dados, {len(cols)} métricas")
    fields = [("suk_month", "INT"), ("brand_details", "STRING"), ("period", "STRING")] + [(c, "DOUBLE") for c in cols]
    rows = [[r["suk_month"], r["brand_details"], r["period"]] + [r[c] for c in cols] for r in recs]
    upsert_month(spark, TABLE_RAW, fields, rows, suk_month)


# ═══════════════════════════════════════════════════════════════════════════
# PARTE 2 — CORE POR COBERTURA
#   Colunas: suk_month, brand_details, period (FY.., B.., CY, PY), coverage,
#   "# Claims" (da linha "# Claims Month"), "# Claims YTD" (da linha "# Claims"),
#   "Frequency", "Average Cost", "Gross LR". As coberturas de COVERAGE_EXCLUDE ficam de fora.
# ═══════════════════════════════════════════════════════════════════════════
COVERAGE_METRICS = {"# claims month": "# Claims", "# claims": "# Claims YTD",
                    "frequency": "Frequency", "average cost (€)": "Average Cost"}
COVERAGE_COLS = ["# Claims", "# Claims YTD", "Frequency", "Average Cost", "Gross LR"]


def coverage_blocks(ws):
    """[(cobertura, {coluna: nº_da_linha})]: um bloco começa numa linha-título seguida de '# Claims'
    (ou 'Claims Charge') e acaba na primeira linha que já não é métrica nem Gross LR."""
    lc = column_index_from_string(LABEL_COL)
    last = ws.max_row
    labels = {r: norm(ws.cell(r, lc).value) for r in range(FIRST_DATA_ROW, last + 2)}
    exclude = {x.strip().lower() for x in COVERAGE_EXCLUDE}
    blocks = []
    for r in range(FIRST_DATA_ROW, last + 1):
        lab = labels[r]
        if not lab or _key(lab) in BLOCK_METRICS | {"# claims month"} or lab.lower().startswith("gross lr"):
            continue
        if _key(labels.get(r + 1, "")) not in BLOCK_METRICS:
            continue
        rows = {}
        for k in range(r + 1, last + 1):
            l = labels.get(k, "")
            if not l:
                continue
            if _key(l) in COVERAGE_METRICS:
                rows.setdefault(COVERAGE_METRICS[_key(l)], k)
            elif _key(l) in BLOCK_METRICS:  # ex.: Claims Charge, não vai para esta tabela
                continue
            elif l.lower().startswith("gross lr"):
                rows.setdefault("Gross LR", k)
            else:
                break
        if lab.lower() not in exclude:
            blocks.append((lab, rows))
    return blocks


def parse_coverage(ws, year, month):
    blocks = coverage_blocks(ws)
    suk_month = year * 100 + month
    out = []
    for c, period in period_columns(year, month):
        brand = norm(ws.cell(HEADER_ROW, c).value)
        if not brand:
            continue
        brand = BRAND_MAP.get(brand, brand)
        for cov, rows in blocks:
            rec = {"suk_month": suk_month, "brand_details": brand,
                   "period": period_label(period, suk_month), "coverage": cov}
            for col in COVERAGE_COLS:
                rec[col] = to_number(ws.cell(rows[col], c).value) if col in rows else None
            if SKIP_EMPTY_MONTHS and all(rec[col] is None for col in COVERAGE_COLS):
                continue
            out.append(rec)
    return out


def run_coverage(spark, recs, year, month):
    suk_month = year * 100 + month
    print(f"[2 cobertura] suk_month = {suk_month}: {len(recs)} linhas")
    fields = [("suk_month", "INT"), ("brand_details", "STRING"), ("period", "STRING"), ("coverage", "STRING")] \
        + [(c, "DOUBLE") for c in COVERAGE_COLS]
    rows = [[r["suk_month"], r["brand_details"], r["period"], r["coverage"]] + [r[c] for c in COVERAGE_COLS]
            for r in recs]
    upsert_month(spark, TABLE_COVERAGE, fields, rows, suk_month)


# ═══════════════════════════════════════════════════════════════════════════
# PARTE 3 — CORE DE PRÉMIOS (lê a tabela raw e reconstrói-se com todos os meses)
#   meses                     = FY.. e B.. = 12; "MM YY" = MM (ex.: "08 26" -> 8)
#   "Average Premium Inflows" = Inflows YTD / meses * 12 / Portfolio
#   "Average Premium Earned"  = Earned Premiums YTD / meses * 12 / Portfolio
#   "Earned Premium / Inflows"= Average Premium Earned / Average Premium Inflows
#   + Claims Charge cy / py / ay YTD (da raw, já ×1000) e os Gross LR de INFLOWS_EXTRA_COLS.
#   Divisões por zero ou por valores vazios ficam a null. period: FY.., B.., CY ou PY.
# ═══════════════════════════════════════════════════════════════════════════
def build_inflows(raw):
    from pyspark.sql import functions as F

    period = F.col("period")
    # "FY 25" e "B26" são anos completos (12 meses); "08 26" são os 8 primeiros meses
    meses = F.when(period.rlike("^[0-9]{2} "), F.substring(period, 1, 2).cast("int")).otherwise(F.lit(12))
    # FY.. e B.. ficam como estão; "MM YY" -> CY (mesmo ano do suk_month) ou PY
    year2 = F.substring(F.col("suk_month").cast("string"), 3, 2)
    period_out = (F.when(period.contains("FY"), period)
                   .when(period.contains("B"), period)
                   .when(F.regexp_extract(period, "([0-9]{2})$", 1) == year2, F.lit("CY"))
                   .otherwise(F.lit("PY")))

    inflows = F.col("Inflows YTD").cast("double")
    earned = F.col("Earned Premiums YTD").cast("double")
    port = F.col("Portfolio").cast("double")

    # só divide quando a carteira não é zero/nula
    avg_inf = F.when(port != 0, inflows / meses * 12 / port)
    avg_earn = F.when(port != 0, earned / meses * 12 / port)
    ratio = F.when(avg_inf != 0, avg_earn / avg_inf)

    return raw.select(
        F.col("suk_month").cast("int").alias("suk_month"),
        F.col("brand_details"),
        period_out.alias("period"),
        inflows.alias("Inflows YTD"),
        port.alias("Portfolio"),
        earned.alias("Earned Premiums YTD"),
        avg_inf.alias("Average Premium Inflows"),
        avg_earn.alias("Average Premium Earned"),
        ratio.alias("Earned Premium / Inflows"),
        *[F.col(src).cast("double").alias(out) for out, src in INFLOWS_CLAIMS_COLS],
        *[F.col(c).cast("double").alias(c) for c in INFLOWS_EXTRA_COLS],
    )


def run_inflows(spark):
    def q(c):
        return "`" + c.replace("`", "``") + "`"

    out_cols = [
        ("suk_month", "INT"), ("brand_details", "STRING"), ("period", "STRING"),
        ("Inflows YTD", "DOUBLE"), ("Portfolio", "DOUBLE"), ("Earned Premiums YTD", "DOUBLE"),
        ("Average Premium Inflows", "DOUBLE"), ("Average Premium Earned", "DOUBLE"),
        ("Earned Premium / Inflows", "DOUBLE"),
    ] + [(out, "DOUBLE") for out, _ in INFLOWS_CLAIMS_COLS] + [(c, "DOUBLE") for c in INFLOWS_EXTRA_COLS]

    sdf = build_inflows(spark.table(TABLE_RAW))
    spark.sql(f"DROP TABLE IF EXISTS {TABLE_INFLOWS}")
    ddl_cols = ", ".join(f"{q(n)} {t}" for n, t in out_cols)
    # nomes com espaços e '/' exigem column mapping (definido na própria tabela)
    spark.sql(
        f"CREATE TABLE {TABLE_INFLOWS} ({ddl_cols}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )
    sdf.write.format("delta").mode("append").saveAsTable(TABLE_INFLOWS)
    print(f"[3 prémios] {sdf.count()} linhas inseridas em {TABLE_INFLOWS}")


# ═══════════════════════════════════════════════════════════════════════════
# EXECUÇÃO: 1) lê e valida todos os ficheiros  2) apaga as tabelas  3) carrega tudo  4) parte 3
# ═══════════════════════════════════════════════════════════════════════════
def main():
    plan = build_plan()
    print(f"{len(plan)} ficheiros em {SRC_DIR}:")
    for f, y, m in plan:
        print(f"  {y * 100 + m}  {f}")

    # 1) leitura e validação (ainda sem tocar nas tabelas)
    loaded, errors = [], []
    if RUN_RAW or RUN_COVERAGE:
        for f, y, m in plan:
            try:
                wb = load_workbook(os.path.join(SRC_DIR, f), data_only=True, read_only=False)
                try:
                    ws = get_sheet(wb)
                    raw = parse_raw(ws, y, m) if RUN_RAW else None
                    cov = parse_coverage(ws, y, m) if RUN_COVERAGE else None
                finally:
                    wb.close()
                loaded.append((y, m, raw, cov))
            except Exception as e:  # noqa: BLE001
                errors.append(f"{f}: {e}")
        if errors:
            raise ValueError("Erros na leitura (as tabelas não foram alteradas):\n  " + "\n  ".join(errors))

    # 2) apaga as tabelas (a parte 3 apaga-se e recria-se sozinha)
    if RESET_TABLES:
        if RUN_RAW:
            spark.sql(f"DROP TABLE IF EXISTS {TABLE_RAW}")
        if RUN_COVERAGE:
            spark.sql(f"DROP TABLE IF EXISTS {TABLE_COVERAGE}")

    # 3) carrega um mês de cada vez, do mais antigo para o mais recente
    for y, m, raw, cov in loaded:
        if RUN_RAW:
            run_raw(spark, raw[0], raw[1], y, m)  # `spark` existe nos notebooks Databricks
        if RUN_COVERAGE:
            run_coverage(spark, cov, y, m)

    # 4) prémios (lê a raw)
    if RUN_INFLOWS:
        run_inflows(spark)


if "spark" in globals():  # só corre dentro do Databricks
    main()
