# -*- coding: utf-8 -*-
"""
PONTE DO LOSS RATIO — wrk_lr_bridge e wrk_lr_bridge_myb

- wrk_lr_bridge: ponte PY (ano anterior) vs CY.
- wrk_lr_bridge_myb: ponte Budget vs CY.
- wrk_lr_bridge_coverage: frequência, custo médio e Gross LR por cobertura, PY vs CY.
- wrk_lr_bridge_coverage_myb: o mesmo por cobertura, Budget vs CY.
As duas primeiras lêem a raw e as outras duas lêem a tabela de coberturas.
Todas são apagadas e reconstruídas em cada execução.

METODOLOGIA DOS CÁLCULOS
------------------------
Fatores (por exposição):
    exposição      = nº sinistros / frequência          ("# Claims of Total YTD" / "Frequency of Total YTD")
    Prémio médio   = Earned Premiums YTD / exposição
    Custo médio    = (Claims Charge of Total YTD - Claims Charge of IBNR YTD) / # Claims of Total YTD
                     (custo médio SEM IBNR)
    Burning cost   = Frequência x Custo médio

Base do LR (LR_TO_PP converte em pp):
    Com LR_BASE_SEM_IBNR = True (por omissão), os efeitos partem do LR sem IBNR:
        LR sem IBNR = Gross LR Total cy - Gross LR IBNR
    e o IBNR entra como efeito próprio (delta direto):
        Efeito IBNR = Gross LR IBNR CY - Gross LR IBNR ref
    Com LR_BASE_SEM_IBNR = False, parte-se do LR total e não há efeito IBNR.

Cada efeito parte do LR de referência (LR25 = LR base de referência):

    Variação X = X_CY / X_ref - 1                       (X = prémio médio, frequência, custo médio)

    Efeito prémio        = LR25 / (1 + Variação prémio médio) - LR25
    Efeito frequência    = LR25 x (1 + Variação frequência) - LR25
    Efeito custo médio   = LR25 x (1 + Variação custo médio) - LR25
    Efeito burning cost  = LR25 x (1 + Variação frequência) x (1 + Variação custo médio) - LR25

Frequência e custo médio são mostrados isoladamente; a soma dos dois difere do burning cost só
pela interação entre ambos. Na reconciliação entra o burning cost (não os dois isolados):

    Efeito outros = (LR base CY - LR base ref) - Efeito prémio - Efeito burning cost
                    [- Efeito IBNR, quando a base é sem IBNR: ver abaixo]

    Efeito prémio + Efeito burning cost + Efeito IBNR + Efeito outros = variação do LR total

As colunas "LR LY (pp)" / "LR Budget (pp)" e "LR CY (pp)" são o LR total. "LR IBNR ..." é informação.

Diagnóstico: k = LR base / (Frequência x Custo médio / Prémio médio),
nas colunas "k LY" / "k Budget" e "k CY". Se k for parecido nos dois
períodos, "Outros" fica perto de zero.

Os efeitos são multiplicados por LR_TO_PP para serem expressos em pp.
"""

from pyspark.sql import functions as F

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO
# ═══════════════════════════════════════════════════════════════════════════

TGT_CATALOG = "agpt_insurance_dv_catalog"
TGT_SCHEMA = "wkb_bus_operations_claimsmotor"

TGT_TABLE_RAW = "raw_claims_drivers_real_all"
TGT_TABLE_BRIDGE = "wrk_lr_bridge"
TGT_TABLE_BRIDGE_MYB = "wrk_lr_bridge_myb"

# Tabela por cobertura (lida pela ponte por cobertura) e as duas pontes por cobertura
TGT_TABLE_COVERAGE = "core_claims_drivers_coverage_real_all"
TGT_TABLE_BRIDGE_COV = "wrk_lr_bridge_coverage"
TGT_TABLE_BRIDGE_COV_MYB = "wrk_lr_bridge_coverage_myb"

TABLE_RAW = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_RAW}"
TABLE_BRIDGE = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE}"
TABLE_BRIDGE_MYB = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE_MYB}"
TABLE_COVERAGE = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_COVERAGE}"
TABLE_BRIDGE_COV = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE_COV}"
TABLE_BRIDGE_COV_MYB = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE_BRIDGE_COV_MYB}"

# True: os efeitos partem do LR sem IBNR e o IBNR é um efeito à parte (o custo médio é sem IBNR).
# False: partem do LR total, sem efeito IBNR.
LR_BASE_SEM_IBNR = True

# 100 se o Gross LR vem em fração (por exemplo, 0.554).
# 1 se já vem em percentagem (por exemplo, 55.4).
LR_TO_PP = 100


def col(name):
    """Referencia nomes de colunas com espaços ou caracteres especiais."""
    return F.col("`" + name.replace("`", "``") + "`")


def build_bridge(raw, comparison):
    """
    Constrói os efeitos da ponte CY vs período de comparação.

    comparison:
        "PY"     -> ano imediatamente anterior vs CY
        "BUDGET" -> Budget do mesmo ano vs CY
    """
    if comparison not in ("PY", "BUDGET"):
        raise ValueError("comparison tem de ser 'PY' ou 'BUDGET'.")

    period = F.upper(F.trim(col("period").cast("string")))
    year2 = F.substring(col("suk_month").cast("string"), 3, 2)
    period_year = F.regexp_extract(period, r"([0-9]{2})$", 1)

    is_month_period = period.rlike(r"^[0-9]{2} ")

    # PY é apenas o ano imediatamente anterior, não qualquer ano diferente.
    previous_year2 = F.lpad(
        F.pmod(
            year2.cast("int") - F.lit(1),
            F.lit(100),
        ).cast("string"),
        2,
        "0",
    )

    is_cy = is_month_period & (period_year == year2)
    is_py = is_month_period & (period_year == previous_year2)
    is_budget = period == F.concat(F.lit("B"), year2)

    period_out = (
        F.when(is_cy, F.lit("CY"))
        .when(is_py, F.lit("PY"))
        .when(is_budget, F.lit("BUDGET"))
    )

    # A frequência é por exposição (não por nº de apólices), por isso o prémio médio
    # também tem de ser por exposição: exposição = nº sinistros / frequência.
    #   Prémio médio = Earned Premiums YTD / exposição = Earned Premiums YTD x Frequência / nº sinistros
    claims = col("# Claims of Total YTD").cast("double")
    frequency = col("Frequency of Total YTD").cast("double")
    charge_total = col("Claims Charge of Total YTD").cast("double")
    charge_ibnr = col("Claims Charge of IBNR YTD").cast("double")

    base = raw.select(
        col("suk_month").cast("int").alias("suk_month"),
        col("brand_details"),
        period_out.alias("p"),

        col("Gross LR Total cy").cast("double").alias("lr_total"),
        col("Gross LR IBNR").cast("double").alias("ibnr"),

        frequency.alias("fr"),

        # Custo médio sem IBNR = (Claims Charge Total - Claims Charge IBNR) / nº sinistros
        F.when(claims != 0, (charge_total - charge_ibnr) / claims).alias("cm"),

        F.when(
            (claims != 0) & frequency.isNotNull(),
            col("Earned Premiums YTD").cast("double") * frequency / claims,
        ).alias("pm"),
    ).where(F.col("p").isNotNull())

    comparison_period = "PY" if comparison == "PY" else "BUDGET"
    comparison_label = "PY" if comparison == "PY" else "Budget"

    reference = base.where(F.col("p") == comparison_period).drop("p")
    cy = base.where(F.col("p") == "CY").drop("p")

    for name in ("lr_total", "ibnr", "fr", "cm", "pm"):
        reference = reference.withColumnRenamed(name, name + "0")
        cy = cy.withColumnRenamed(name, name + "1")

    joined = reference.join(
        cy,
        ["suk_month", "brand_details"],
        "inner",
    )

    # Base dos cálculos: LR sem IBNR (o custo médio é sem IBNR) ou LR total.
    if LR_BASE_SEM_IBNR:
        lr0 = F.col("lr_total0") - F.col("ibnr0")
        lr1 = F.col("lr_total1") - F.col("ibnr1")
    else:
        lr0 = F.col("lr_total0")
        lr1 = F.col("lr_total1")

    valid_factors = (
        F.col("pm0").isNotNull()
        & F.col("pm1").isNotNull()
        & F.col("cm0").isNotNull()
        & F.col("cm1").isNotNull()
        & F.col("fr0").isNotNull()
        & F.col("fr1").isNotNull()
        & (F.col("pm1") != 0)
        & (F.col("cm0") != 0)
        & (F.col("fr0") != 0)
    )

    # Variações face à referência.
    var_premio = F.col("pm1") / F.col("pm0") - 1
    var_freq = F.col("fr1") / F.col("fr0") - 1
    var_custo = F.col("cm1") / F.col("cm0") - 1

    # Cada efeito parte do LR de referência (LR25).
    lr_a_premio = F.when(valid_factors, lr0 / (1 + var_premio))
    lr_a_freq = F.when(valid_factors, lr0 * (1 + var_freq))
    lr_a_custo = F.when(valid_factors, lr0 * (1 + var_custo))
    lr_a_burning = F.when(valid_factors, lr0 * (1 + var_freq) * (1 + var_custo))

    # Diagnóstico do "Outros": k = LR base / (Frequência x Custo médio / Prémio médio).
    def k_factor(lr_base, fr, cm, pm):
        model = fr * cm / pm
        return F.when(
            fr.isNotNull() & cm.isNotNull() & pm.isNotNull() & (pm != 0) & (model != 0),
            lr_base / model,
        )

    k_ref = k_factor(lr0, F.col("fr0"), F.col("cm0"), F.col("pm0"))
    k_cy = k_factor(lr1, F.col("fr1"), F.col("cm1"), F.col("pm1"))

    scale = F.lit(float(LR_TO_PP))

    efeito_premio = (lr_a_premio - lr0) * scale
    efeito_freq = (lr_a_freq - lr0) * scale
    efeito_custo = (lr_a_custo - lr0) * scale
    efeito_burning = (lr_a_burning - lr0) * scale

    # Residual: o que o prémio e o burning cost não explicam no LR base.
    efeito_outros = (lr1 - lr0) * scale - efeito_premio - efeito_burning

    effect_cols = [
        efeito_premio.alias("Efeito prémio médio (pp)"),
        efeito_freq.alias("Efeito frequência (pp)"),
        efeito_custo.alias("Efeito custo médio (pp)"),
        efeito_burning.alias("Efeito burning cost (pp)"),
    ]
    if LR_BASE_SEM_IBNR:
        # Delta direto do IBNR, sem aplicar os fatores da ponte.
        effect_cols.append(((F.col("ibnr1") - F.col("ibnr0")) * scale).alias("Efeito IBNR (pp)"))
    effect_cols.append(efeito_outros.alias("Efeito outros (pp)"))

    # LR de referência e CY, efeitos da ponte e fatores usados.
    return joined.select(
        "suk_month",
        "brand_details",

        (F.col("lr_total0") * scale).alias("LR LY (pp)" if comparison == "PY" else "LR Budget (pp)"),
        (F.col("lr_total1") * scale).alias("LR CY (pp)"),
        (F.col("ibnr0") * scale).alias(
            "LR IBNR LY (pp)" if comparison == "PY" else "LR IBNR Budget (pp)"
        ),
        (F.col("ibnr1") * scale).alias("LR IBNR CY (pp)"),

        *effect_cols,

        F.col("pm0").alias(f"Prémio médio {comparison_label}"),
        F.col("pm1").alias("Prémio médio CY"),
        F.col("cm0").alias(f"Custo médio {comparison_label}"),
        F.col("cm1").alias("Custo médio CY"),
        F.col("fr0").alias(f"Frequência {comparison_label}"),
        F.col("fr1").alias("Frequência CY"),

        k_ref.alias("k LY" if comparison == "PY" else "k Budget"),
        k_cy.alias("k CY"),
    )


def build_bridge_coverage(cov, comparison):
    """
    Ponte por cobertura, a partir de core_claims_drivers_coverage_real_all.

    Para cada suk_month x brand_details x coverage compara a referência (PY ou Budget) com o CY:
    frequência, custo médio, nº de sinistros e Gross LR, com as variações em % e os efeitos em pp
    de cada cobertura (frequência, custo médio e burning cost), sobre o Gross LR da própria
    cobertura no período de referência:

        Efeito frequência (cobertura)   = LR_cob_ref x variação da frequência
        Efeito custo médio (cobertura)  = LR_cob_ref x variação do custo médio
        Efeito burning cost (cobertura) = LR_cob_ref x ((1 + var. frequência) x (1 + var. custo médio) - 1)

    Os efeitos por cobertura são indicativos: não somam exatamente aos efeitos da ponte total,
    porque o LR total tem componentes que não estão nas coberturas (IBNR, large claims, etc.)
    e o prémio médio não é por cobertura.
    """
    if comparison not in ("PY", "BUDGET"):
        raise ValueError("comparison tem de ser 'PY' ou 'BUDGET'.")

    period = F.upper(F.trim(col("period").cast("string")))
    year2 = F.substring(col("suk_month").cast("string"), 3, 2)

    # Na tabela de coberturas o period já vem como FY.., B.., CY ou PY.
    reference_period = F.lit("PY") if comparison == "PY" else F.concat(F.lit("B"), year2)
    reference_label = "LY" if comparison == "PY" else "Budget"

    base = cov.select(
        col("suk_month").cast("int").alias("suk_month"),
        col("brand_details"),
        col("coverage"),
        period.alias("p"),
        col("# Claims YTD").cast("double").alias("nc"),
        col("Frequency").cast("double").alias("fr"),
        col("Average Cost").cast("double").alias("cm"),
        col("Gross LR").cast("double").alias("lr"),
    )

    reference = (
        base.where(F.col("p") == reference_period).drop("p")
    )
    cy = base.where(F.col("p") == "CY").drop("p")

    for name in ("nc", "fr", "cm", "lr"):
        reference = reference.withColumnRenamed(name, name + "0")
        cy = cy.withColumnRenamed(name, name + "1")

    joined = reference.join(cy, ["suk_month", "brand_details", "coverage"], "inner")

    scale = F.lit(float(LR_TO_PP))
    valid = (
        F.col("fr0").isNotNull() & F.col("fr1").isNotNull() & (F.col("fr0") != 0)
        & F.col("cm0").isNotNull() & F.col("cm1").isNotNull() & (F.col("cm0") != 0)
    )
    var_freq = F.when(F.col("fr0") != 0, F.col("fr1") / F.col("fr0") - 1)
    var_custo = F.when(F.col("cm0") != 0, F.col("cm1") / F.col("cm0") - 1)

    return joined.select(
        "suk_month",
        "brand_details",
        "coverage",

        F.col("fr0").alias(f"Frequência {reference_label}"),
        F.col("fr1").alias("Frequência CY"),
        (var_freq * 100).alias("Variação frequência (%)"),

        F.col("cm0").alias(f"Custo médio {reference_label}"),
        F.col("cm1").alias("Custo médio CY"),
        (var_custo * 100).alias("Variação custo médio (%)"),

        F.col("nc0").alias(f"# Claims YTD {reference_label}"),
        F.col("nc1").alias("# Claims YTD CY"),

        (F.col("lr0") * scale).alias(f"Gross LR {reference_label} (pp)"),
        (F.col("lr1") * scale).alias("Gross LR CY (pp)"),

        F.when(valid, F.col("lr0") * var_freq * scale).alias("Efeito frequência (pp)"),
        F.when(valid, F.col("lr0") * var_custo * scale).alias("Efeito custo médio (pp)"),
        F.when(valid, F.col("lr0") * ((1 + var_freq) * (1 + var_custo) - 1) * scale)
        .alias("Efeito burning cost (pp)"),
    )


def write_bridge(spark, sdf, table_name):
    """Cria ou substitui uma tabela Delta com os dados da ponte."""

    def quote_identifier(name):
        return "`" + name.replace("`", "``") + "`"

    spark.sql(f"DROP TABLE IF EXISTS {table_name}")

    column_types = {
        "suk_month": "INT",
        "brand_details": "STRING",
        "coverage": "STRING",
    }

    ddl_columns = ", ".join(
        f"{quote_identifier(name)} {column_types.get(name, 'DOUBLE')}"
        for name in sdf.columns
    )

    spark.sql(
        f"CREATE TABLE {table_name} ({ddl_columns}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )

    sdf.write.format("delta").mode("append").saveAsTable(table_name)
    print(f"{sdf.count()} linhas inseridas em {table_name}")


def run_bridge(spark):
    if not spark.catalog.tableExists(TABLE_RAW):
        raise ValueError(f"Tabela raw não encontrada: {TABLE_RAW}")

    raw = spark.table(TABLE_RAW)

    required = [
        "# Claims of Total YTD", "Frequency of Total YTD", "Claims Charge of Total YTD",
        "Claims Charge of IBNR YTD", "Earned Premiums YTD", "Gross LR Total cy", "Gross LR IBNR",
    ]
    missing = [c for c in required if c not in raw.columns]
    if missing:
        raise ValueError(f"A raw não tem as colunas {missing}. Corre primeiro o script principal.")

    # As duas pontes são reconstruídas em cada execução a partir da raw.
    write_bridge(spark, build_bridge(raw, "PY"), TABLE_BRIDGE)
    write_bridge(spark, build_bridge(raw, "BUDGET"), TABLE_BRIDGE_MYB)

    # Pontes por cobertura (lêem a tabela de coberturas).
    if not spark.catalog.tableExists(TABLE_COVERAGE):
        raise ValueError(f"Tabela de coberturas não encontrada: {TABLE_COVERAGE}")
    cov = spark.table(TABLE_COVERAGE)
    write_bridge(spark, build_bridge_coverage(cov, "PY"), TABLE_BRIDGE_COV)
    write_bridge(spark, build_bridge_coverage(cov, "BUDGET"), TABLE_BRIDGE_COV_MYB)


if "spark" in globals():  # Só corre dentro do Databricks.
    run_bridge(spark)
