# -*- coding: utf-8 -*-
"""
CORE CLAIMS DRIVERS INFLOWS BUDGET
Lê raw_claims_drivers_budget_all e cria core_claims_drivers_inflows_budget_all
(1 linha por suk_month x brand), com os mesmos nomes de colunas da tabela do real.
Apaga e recria a tabela em cada execução.
"""
from pyspark.sql import functions as F

CATALOG = "agpt_insurance_dv_catalog"
SCHEMA = "wkb_bus_operations_claimsmotor"
TABLE_RAW_BUDGET = f"{CATALOG}.{SCHEMA}.raw_claims_drivers_budget_all"
TABLE_INFLOWS_BUDGET = f"{CATALOG}.{SCHEMA}.core_claims_drivers_inflows_budget_all"

# (nome na tabela de saída, nome da coluna na raw), iguais aos do real
COPY_COLS = [
    ("# Claims Total YTD", "# Claims of Total YTD"),
    ("# Claims Large Claims YTD", "# Claims of Large Claims YTD"),
    ("# Claims Attritional YTD", "# Claims of Attritional YTD"),
    ("Claims Charge cy YTD", "Claims Charge of Total YTD"),
    ("Claims Charge py YTD", "Claims Charge py"),
    ("Claims Charge ay YTD", "Claims Charge ay"),
    ("Claims Charge Large Claims YTD", "Claims Charge of Large Claims YTD"),
    ("Claims Charge Attritional YTD", "Claims Charge of Attritional YTD"),
    ("Claims Charge IBNR YTD", "Claims Charge of IBNR YTD"),
    ("Claims Charge IBNER YTD", "Claims Charge of IBNER YTD"),
    ("Claims Charge IBNR/IBNER YTD", "Claims Charge of IBNR/IBNER YTD"),
    ("Average Cost (€) f/f", "Average Cost (€) f/f"),
    ("Gross LR CY f/f", "Gross LR CY f/f"),
    ("Gross LR Total cy", "Gross LR Total cy"),
    ("Gross LR Total py", "Gross LR Total py"),
    ("Gross LR Total ay", "Gross LR Total ay"),
    ("Gross LR IBNR", "Gross LR IBNR"),
    ("Gross LR IBNER", "Gross LR IBNER"),
    ("Gross LR IBNR/IBNER", "Gross LR IBNR/IBNER"),
]

# Colunas que são obrigatórias para a tabela fazer sentido
REQUIRED = ["suk_month", "brand", "Inflows YTD", "Portfolio", "Earned Premiums YTD"]


def q(name):
    return "`" + name.replace("`", "``") + "`"


def build_inflows_budget(raw):
    missing = [c for c in REQUIRED if c not in raw.columns]
    if missing:
        raise ValueError(
            f"A raw do budget não tem as colunas {missing}. "
            "Volta a correr o script da raw do budget (apaga e recria a tabela)."
        )

    inflows = F.col("Inflows YTD").cast("double")
    earned = F.col("Earned Premiums YTD").cast("double")
    portfolio = F.col("Portfolio").cast("double")

    avg_inflows = F.when(portfolio != 0, inflows / portfolio)
    avg_earned = F.when(portfolio != 0, earned / portfolio)
    ratio = F.when(avg_inflows != 0, avg_earned / avg_inflows)

    copied, absent = [], []
    for out, src in COPY_COLS:
        if src in raw.columns:
            copied.append(F.col(q(src)).cast("double").alias(out))
        else:
            copied.append(F.lit(None).cast("double").alias(out))
            absent.append(src)
    if absent:
        print("Aviso: colunas que não existem na raw (ficam a null):", absent)

    return raw.select(
        F.col("suk_month").cast("int").alias("suk_month"),
        F.col("brand"),
        inflows.alias("Inflows YTD"),
        portfolio.alias("Portfolio"),
        earned.alias("Earned Premiums YTD"),
        avg_inflows.alias("Average Premium Inflows"),
        avg_earned.alias("Average Premium Earned"),
        ratio.alias("Earned Premium / Inflows"),
        *copied,
    )


def run():
    if not spark.catalog.tableExists(TABLE_RAW_BUDGET):
        raise ValueError(f"Tabela raw não encontrada: {TABLE_RAW_BUDGET}")

    df = build_inflows_budget(spark.table(TABLE_RAW_BUDGET))

    spark.sql(f"DROP TABLE IF EXISTS {TABLE_INFLOWS_BUDGET}")
    cols = [("suk_month", "INT"), ("brand", "STRING")] + [
        (n, "DOUBLE") for n in df.columns if n not in ("suk_month", "brand")
    ]
    ddl = ", ".join(f"{q(n)} {t}" for n, t in cols)
    spark.sql(
        f"CREATE TABLE {TABLE_INFLOWS_BUDGET} ({ddl}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )
    df.write.format("delta").mode("append").saveAsTable(TABLE_INFLOWS_BUDGET)
    print(f"{df.count()} linhas carregadas em {TABLE_INFLOWS_BUDGET}")


if "spark" in globals():  # só corre dentro do Databricks
    run()
