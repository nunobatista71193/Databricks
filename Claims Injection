# ============================================================
# PROCESSAMENTO
# ============================================================

total_rows_loaded = 0
successful_files = 0
failed_files = []

for file_path in sorted(files):
    file_name = file_path.split("/")[-1]

    print("\n" + "=" * 80)
    print(f"Processando {file_name}")
    print("=" * 80)

    try:
        # 1) ler tudo primeiro: se falhar, a tabela não é tocada
        pdf, ano = read_excel_robust(file_path, file_name)

        # 2) em modo incremental, remover só as linhas deste ficheiro
        if table_exists():
            spark.sql(
                f"DELETE FROM {full_table_name} WHERE source_file = '{file_name}'"
            )

        rows_file = 0
        for start in range(0, len(pdf), CHUNK_SIZE):
            chunk = pdf.iloc[start:start + CHUNK_SIZE]

            mode = "append" if table_exists() else "overwrite"
            write_chunk(chunk, file_name, ano, mode)

            rows_file += len(chunk)
            print(f"  bloco {start // CHUNK_SIZE + 1}: {rows_file:,}/{len(pdf):,} linhas")

        total_rows_loaded += rows_file
        successful_files += 1
        del pdf

    except Exception as e:
        msg = str(e).split("JVM stacktrace")[0][:2000]
        print(f"\nERRO NO FICHEIRO {file_name}\n{msg}")
        failed_files.append((file_name, msg))


