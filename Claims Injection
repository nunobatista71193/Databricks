# -*- coding: utf-8 -*-
"""
Injeta o Template_Claims.xlsx (1 ou mais sheets) numa tabela Delta no Databricks.

- Cada sheet  -> um valor na coluna `brand` (nome da sheet, ou o mapeamento SHEET_TO_BRAND)
- Colunas AE:AP (meses) -> unpivot para linhas, com `suk_month` = AAAAMM (ex.: Jan/26 -> 202601)
- Linhas da coluna D que passam a ser colunas:
    * Portfolio, Inflows, Earned Premiums
    * "# Claims", "Frequency", "Average Cost (€)", "Claims Charge" -> "<linha> of <bloco> YTD"
    * "# Claims Month"  -> "# Claims Month of <nome 2 linhas acima>"
    * "Gross LR *"      -> mantém o nome (se repetido entre blocos, acrescenta " of <bloco>")
    * qualquer linha com "YTD" no nome
- Cada execução apaga a tabela de destino e cria-a de novo só com o que está no Excel.
"""
import os
import re
import datetime as dt
import unicodedata
import sys
import subprocess
import importlib

try:
    import openpyxl  # noqa: F401
except ModuleNotFoundError:  # cluster sem openpyxl: instala e continua
    subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "openpyxl"])
    importlib.invalidate_caches()

from openpyxl import load_workbook
from openpyxl.utils import column_index_from_string, get_column_letter

# ───────────────────────── CONFIGURAÇÃO ─────────────────────────
# Origem: ficheiro Excel num Volume do Unity Catalog
SRC_CATALOG = "agpt_insurance_dv_catalog"
SRC_SCHEMA  = "wkb_bus_operations_claimsmotor"
SRC_VOLUME  = "pba&uw"
SRC_FOLDER  = "01_raw/budget/"   # pasta dentro do volume ("" se estiver na raiz)
SRC_FILE    = "Claims drivers - budget 2026_mes.xlsx"

# Destino: tabela Delta
TGT_CATALOG = "agpt_insurance_dv_catalog"
TGT_SCHEMA  = "wkb_bus_operations_claimsmotor"
TGT_TABLE   = "raw_claims_drivers_budget_all"

EXCEL_PATH   = "/" + "/".join(p.strip("/") for p in
                              ["Volumes", SRC_CATALOG, SRC_SCHEMA, SRC_VOLUME, SRC_FOLDER, SRC_FILE] if p)
TARGET_TABLE = f"{TGT_CATALOG}.{TGT_SCHEMA}.{TGT_TABLE}"

LABEL_COL      = "D"    # coluna com os nomes das linhas
FIRST_MONTH_COL = "AE"  # primeira coluna de meses
LAST_MONTH_COL  = "AP"  # última coluna de meses
HEADER_ROW     = 3      # linha com as datas (Jan/26, ...)
FIRST_DATA_ROW = 4

# Sheet -> brand. Só as sheets listadas aqui são carregadas.
# Se deixares o dicionário vazio ({}), carrega todas as sheets e usa o nome da sheet como brand.
SHEET_TO_BRAND = {
    "Motor ags ND": "AGS ND",
    "Motor sd": "SD",
    "Motor ocs": "OCS",
    "Motor all": "Non Life",
}
SKIP_EMPTY_MONTHS = True  # ignora meses em que todas as métricas estão vazias

# Linhas que ganham o sufixo " YTD" no nome da coluna e são multiplicadas por 1000 (k€ -> €)
YTD_ROWS = {"inflows", "earned premiums"}
YTD_SUFFIX = " YTD"
YTD_FACTOR = 1000
# ────────────────────────────────────────────────────────────────

_MONTHS = {"jan": 1, "fev": 2, "feb": 2, "mar": 3, "abr": 4, "apr": 4, "mai": 5, "may": 5,
           "jun": 6, "jul": 7, "ago": 8, "aug": 8, "set": 9, "sep": 9, "out": 10, "oct": 10,
           "nov": 11, "dez": 12, "dec": 12}

SIMPLE_ROWS = {"portfolio", "portfólio", "inflows", "earned premiums"}
CLAIMS_MONTH_RE = re.compile(r"^#\s*claims\s*month$", re.I)
CLAIMS_RE = re.compile(r"^#\s*claims$", re.I)
# Linhas de cada bloco que passam a "<linha> of <bloco> YTD"
BLOCK_METRICS = {"# claims", "frequency", "average cost (€)", "claims charge"}


def norm(v):
    """Texto limpo: sem espaços repetidos nem nas pontas."""
    return re.sub(r"\s+", " ", str(v)).strip() if v is not None else ""


def to_suk_month(v):
    """datetime / 'Jan/26' / 'jan-2026' / 202601 -> 202601 (int)."""
    if isinstance(v, (dt.datetime, dt.date)):
        return v.year * 100 + v.month
    if isinstance(v, (int, float)) and 190001 <= int(v) <= 299912:
        return int(v)
    m = re.match(r"^\s*([A-Za-zçÇ]{3})[a-z]*[\s/\-\.]+(\d{2}|\d{4})\s*$", str(v))
    if m and m.group(1).lower() in _MONTHS:
        y = int(m.group(2))
        y = y + 2000 if y < 100 else y
        return y * 100 + _MONTHS[m.group(1).lower()]
    raise ValueError(f"Não consegui interpretar o mês: {v!r}")


def to_number(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    try:
        return float(str(v).replace(" ", "").replace(" ", "").replace(",", "."))
    except ValueError:
        return None  # #DIV/0!, #N/A, texto...


def select_rows(ws):
    """Devolve {nome_da_coluna: nº_da_linha} para as linhas a incorporar."""
    lc = column_index_from_string(LABEL_COL)
    labels = {r: norm(ws.cell(r, lc).value) for r in range(FIRST_DATA_ROW, ws.max_row + 1)}

    def key(label):
        return re.sub(r"^#\s*", "# ", label.lower())

    def section_of(row):
        # bloco = primeira linha acima que não é uma métrica do bloco nem um Gross LR
        # (ex.: "# Claims" na linha 11 -> bloco "Crash, Collision or Rollover" na linha 10)
        for r in range(row - 1, FIRST_DATA_ROW - 1, -1):
            lab = labels.get(r, "")
            if lab and key(lab) not in BLOCK_METRICS | {"# claims month"} and not lab.lower().startswith("gross lr"):
                return lab
        return ""

    picked, gross = [], []
    for r, lab in labels.items():
        if not lab:
            continue
        low = lab.lower()
        if low in YTD_ROWS:
            picked.append((lab + YTD_SUFFIX, r))
        elif low in SIMPLE_ROWS or "ytd" in low:
            picked.append((lab, r))
        elif CLAIMS_MONTH_RE.match(lab):
            picked.append((f"# Claims Month of {labels.get(r - 2, '')}".strip(), r))
        elif key(lab) in BLOCK_METRICS:
            picked.append((f"{lab} of {section_of(r)}{YTD_SUFFIX}", r))
        elif low.startswith("gross lr"):
            gross.append((lab, r))

    # Gross LR*: nome repetido entre blocos -> desambigua com o nome do bloco
    counts = {}
    for lab, _ in gross:
        counts[lab] = counts.get(lab, 0) + 1
    for lab, r in gross:
        picked.append((f"{lab} of {section_of(r)}" if counts[lab] > 1 else lab, r))

    cols = {}
    for name, r in sorted(picked, key=lambda x: x[1]):
        if name in cols:
            raise ValueError(f"Nome de coluna duplicado '{name}' (linhas {cols[name]} e {r})")
        cols[name] = r
    return cols


def parse_sheet(ws, brand):
    """Sheet -> lista de dicts (1 por brand x mês), métricas em colunas."""
    rows = select_rows(ws)
    c1 = column_index_from_string(FIRST_MONTH_COL)
    c2 = column_index_from_string(LAST_MONTH_COL)
    out = []
    for c in range(c1, c2 + 1):
        head = ws.cell(HEADER_ROW, c).value
        if head is None:
            continue
        rec = {"brand": brand, "suk_month": to_suk_month(head)}
        for name, r in rows.items():
            val = to_number(ws.cell(r, c).value)
            if val is not None and name.endswith(YTD_SUFFIX) and name[:-len(YTD_SUFFIX)].lower() in YTD_ROWS:
                val = val * YTD_FACTOR
            rec[name] = val
        if SKIP_EMPTY_MONTHS and all(rec[n] is None for n in rows):
            continue
        out.append(rec)
    return out, list(rows)


def read_workbook(path):
    """Devolve {brand: (registos, colunas_métricas)} — data_only=True lê os valores calculados."""
    wb = load_workbook(path, data_only=True, read_only=False)
    result = {}
    actual = {n.strip().lower(): n for n in wb.sheetnames}  # ignora maiúsculas/minúsculas
    wanted = list(SHEET_TO_BRAND) or wb.sheetnames
    missing = [n for n in wanted if n.strip().lower() not in actual]
    if missing:
        raise ValueError(f"Sheets não encontradas no Excel: {missing}. Existentes: {wb.sheetnames}")
    for name in wanted:
        brand = SHEET_TO_BRAND.get(name, name)
        result[brand] = parse_sheet(wb[actual[name.strip().lower()]], brand)
    return result


# ───────────────────────── LOCALIZAR O FICHEIRO ─────────────────────────
def _canon(name):
    """Nome comparável: sem diferenças de maiúsculas, espaços repetidos/não separáveis ou acentos decompostos."""
    n = unicodedata.normalize("NFC", name).replace("\u00a0", " ")
    return re.sub(r"\s+", " ", n).strip().lower()


def resolve_excel_path(path):
    """Devolve o caminho do Excel. Se o caminho exato não existir, procura o ficheiro com o nome
    equivalente na pasta e, em último caso, no volume todo; se não o encontrar, diz o que existe."""
    if os.path.isfile(path):
        return path
    folder, fname = os.path.dirname(path), os.path.basename(path)

    if os.path.isdir(folder):
        files = sorted(os.listdir(folder))
        for f in files:
            if _canon(f) == _canon(fname):
                print(f"Ficheiro encontrado com nome ligeiramente diferente: {f!r}")
                return os.path.join(folder, f)
    else:
        files = None

    # procura no volume todo
    volume_root = "/" + "/".join(p.strip("/") for p in ["Volumes", SRC_CATALOG, SRC_SCHEMA, SRC_VOLUME])
    found = []
    for root, _dirs, names in os.walk(volume_root):
        found += [os.path.join(root, f) for f in names if _canon(f) == _canon(fname)]
    if len(found) == 1:
        print(f"Ficheiro não está em {folder}; encontrado em {found[0]} (corrige SRC_FOLDER).")
        return found[0]

    msg = [f"Ficheiro não encontrado: {path}"]
    if files is not None:
        msg.append(f"Ficheiros em {folder}:")
        msg += [f"  {f!r}" for f in files]
    else:
        parent = folder
        while parent and not os.path.isdir(parent):
            parent = os.path.dirname(parent)
        msg.append(f"A pasta {folder} não existe. Última pasta que existe: {parent or '/'}")
        msg.append("Conteúdo:")
        msg += [f"  {f!r}" for f in sorted(os.listdir(parent or "/"))]
    if len(found) > 1:
        msg.append("Há vários ficheiros com esse nome no volume: " + ", ".join(found))
    raise FileNotFoundError("\n".join(msg))


# ───────────────────────── DATABRICKS ─────────────────────────
def write_to_delta(spark, parsed):
    from pyspark.sql import types as T

    def q(c):  # nome de coluna entre backticks
        return "`" + c.replace("`", "``") + "`"

    all_cols = []
    for _, (_, cols) in parsed.items():
        all_cols += [c for c in cols if c not in all_cols]
    schema = T.StructType(
        [T.StructField("brand", T.StringType()), T.StructField("suk_month", T.IntegerType())]
        + [T.StructField(c, T.DoubleType()) for c in all_cols]
    )
    records = [
        [r["brand"], r["suk_month"]] + [r.get(c) for c in all_cols]
        for recs, _ in parsed.values() for r in recs
    ]
    sdf = spark.createDataFrame(records, schema=schema)

    # A tabela é apagada e criada de novo em cada execução.
    spark.sql(f"DROP TABLE IF EXISTS {TARGET_TABLE}")

    # Nomes com espaços, '#', ',' ... exigem column mapping: define-se na própria tabela
    # (funciona também em serverless, onde não se podem alterar configs do Spark).
    ddl_cols = ", ".join([f"{q('brand')} STRING", f"{q('suk_month')} INT"] + [f"{q(c)} DOUBLE" for c in all_cols])
    spark.sql(
        f"CREATE TABLE {TARGET_TABLE} ({ddl_cols}) USING DELTA "
        "TBLPROPERTIES ('delta.columnMapping.mode' = 'name', "
        "'delta.minReaderVersion' = '2', 'delta.minWriterVersion' = '5')"
    )
    sdf.write.format("delta").mode("append").saveAsTable(TARGET_TABLE)
    print(f"{sdf.count()} linhas inseridas em {TARGET_TABLE} (brands: {list(parsed)})")


def main():
    parsed = read_workbook(resolve_excel_path(EXCEL_PATH))
    for b, (recs, cols) in parsed.items():
        print(f"{b}: {len(recs)} meses, {len(cols)} métricas")
    write_to_delta(spark, parsed)  # `spark` existe nos notebooks Databricks


if "spark" in globals():  # só corre dentro do Databricks
    main()
