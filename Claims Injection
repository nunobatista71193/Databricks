def to_local_path(path: str) -> str:
    return path[len("dbfs:"):] if path.startswith("dbfs:") else path


def sanitize_column_name(name) -> str:
    n = str(name)

    # Excel codifica caracteres especiais como _xHHHH_ (ex.: _x0020_ = espaço)
    n = re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m.group(1), 16)), n)

    # remover acentos
    n = unicodedata.normalize("NFKD", n)
    n = "".join(c for c in n if not unicodedata.combining(c))

    for original, substituto in {
        "º": "o", "ª": "a", "%": "pct", "#": "num",
        "€": "eur", "$": "usd", "&": "e", "@": "at",
    }.items():
        n = n.replace(original, substituto)

    # qualquer caracter que não seja letra/número/_ passa a "_" (inclui . , ; { } ( ) = / \ espaços, etc.)
    n = re.sub(r"[^0-9A-Za-z_]", "_", n)
    n = re.sub(r"_+", "_", n).strip("_")

    if not n:
        n = "coluna_sem_nome"
    if n[0].isdigit():
        n = f"c_{n}"

    return n.lower()


def sanitize_pandas_columns(pdf: pd.DataFrame) -> pd.DataFrame:
    vistos = {}
    novos = []

    for c in pdf.columns:
        n = sanitize_column_name(c)
        if n in vistos:
            vistos[n] += 1
            n = f"{n}_{vistos[n]}"
        else:
            vistos[n] = 0
        novos.append(n)

    pdf.columns = novos
    return pdf


def read_excel_robust(volume_path, file_name):
    local_path = to_local_path(volume_path)

    if not os.path.exists(local_path):
        raise Exception(f"Ficheiro não encontrado: {local_path}")

    match = re.search(r"(\d{4})", file_name)
    if not match:
        raise Exception(f"Não foi possível identificar o ano em {file_name}")

    ano = match.group(1)
    sheet_name = f"CLAIMS_{ano}"

    excel = pd.ExcelFile(local_path)
    print(f"Sheets disponíveis: {excel.sheet_names}")

    if sheet_name not in excel.sheet_names:
        raise Exception(
            f"Sheet {sheet_name} não encontrada. Sheets disponíveis: {excel.sheet_names}"
        )

    print(f"A ler sheet: {sheet_name}")
    pdf = pd.read_excel(excel, sheet_name=sheet_name, dtype=str)

    # remover linhas/colunas totalmente vazias (antes de qualquer fillna)
    pdf = pdf.dropna(axis=0, how="all").dropna(axis=1, how="all")

    if len(pdf) == 0:
        raise Exception(f"Sem registos na sheet {sheet_name}")

    pdf = sanitize_pandas_columns(pdf)

    # vazios -> None (NULL no Delta); tudo o resto fica string
    pdf = pdf.astype(object).where(pdf.notna(), None)

    print(f"Linhas lidas: {len(pdf):,}")
    print(f"Colunas lidas: {len(pdf.columns)}")

    return pdf, ano


def write_chunk(pdf_chunk, file_name, ano, write_mode):
    schema = StructType([StructField(c, StringType(), True) for c in pdf_chunk.columns])
    sdf = spark.createDataFrame(pdf_chunk, schema=schema)

    sdf = (
        sdf
        .withColumn("source_file", lit(file_name))
        .withColumn("claim_year", lit(ano))
        .withColumn("file_type", lit("CLAIMS"))
        .withColumn("load_timestamp", current_timestamp())
    )

    writer = sdf.write.format("delta").mode(write_mode)

    if write_mode == "overwrite":
        writer = writer.option("overwriteSchema", "true")
    else:
        writer = writer.option("mergeSchema", "true")

    writer.saveAsTable(full_table_name)


