%_eg_conditional_dropds(WORK.QUERY_FOR_SAS_DASHBOARD_0001);

PROC SQL;
   CREATE TABLE WORK.QUERY_FOR_SAS_DASHBOARD_0001 AS 
   SELECT t1.brand, 
          t1.categoria, 
          t1.pack, 
          t2.anomes_sim, 
          t2.anomes_homologo, 
          t1.Quotes AS Quotes_Homologo, 
          t1.Policies AS Policies_Homologo, 
          t1.Policies_Premium AS Policies_Premium_Homologo
      FROM WORK.SAS_DASHBOARD t1
           INNER JOIN WORK.QUERY_FOR_SAS_DASHBOARD_0000 t2 ON (t1.anomes_sim = t2.anomes_homologo);
QUIT;
