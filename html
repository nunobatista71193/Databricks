function freqView(){let h='<div class="controls"><b>Carteira</b><select id="freqSeg"><option>Total</option><option>Novo negócio</option><option>Renovações</option></select><b>Cobertura</b><select id="freqCov"><option>Total</option><option>DP</option><option>RC</option></select></div><div id="freqBody"></div>';return h}function renderFreq(){let sg=document.getElementById('freqSeg').value,cv=document.getElementById('freqCov').value,rows=['AGS','SD','OCS','Grupo'].map(b=>{let a=agg('YTD26',{brand:b,seg:sg,cov:cv}),p=agg('YTD25',{brand:b,seg:sg,cov:cv});return{b,a,p}}),max=Math.max(...rows.map(x=>x.a.f))*1.15,W=920,H=330,L=170,R=80,T=25,BB=45,X=x=>L+x/max*(W-L-R),g='';rows.forEach((q,i)=>{let y=T+i*65;g+=`<text x="${L-15}" y="${y+22}" text-anchor="end" font-size="13" font-weight="700">${BL[q.b]}</text><line x1="${L}" y1="${y+17}" x2="${W-R}" y2="${y+17}" stroke="#e0e3e5"/><circle cx="${X(q.p.f)}" cy="${y+17}" r="8" fill="#3f78a8"/><circle cx="${X(q.a.f)}" cy="${y+17}" r="10" fill="#f2541b"/><text x="${W-R+8}" y="${y+21}" font-size="12">${pct(q.a.f)} · ${ds(rel(q.a.f,q.p.f))}</text>`});let tab='<table><tr><th>Brand</th><th>Frequency YTD25</th><th>Frequency YTD26</th><th>Δ</th><th>Avg Cost YTD26</th><th>LR YTD26</th></tr>'+rows.map(q=>`<tr><td>${BL[q.b]}</td><td>${pct(q.p.f)}</td><td><b>${pct(q.a.f)}</b></td><td>${ds(rel(q.a.f,q.p.f))}</td><td>${eur(q.a.cost)}</td><td>${pct(q.a.lr)}</td></tr>`).join('')+'</table>';document.getElementById('freqBody').innerHTML=`<div class="grid2"><div class="card"><h3>Frequency comparative</h3><p class="cap">Blue = YTD25 · Orange = YTD26</p><svg viewBox="0 0 ${W} ${H}">${g}</svg></div><div class="card scroll"><h3>Frequency detail</h3>${tab}</div></div>`}const rel=(a,b)=>(a/b-1)*100;
function lrComp(name){let q=L[name],mets=[['LR CY f/f','lr_ff'],['IBNR','ibnr'],['LR Total CY','lr_cy'],['PY','py'],['LR Total AY','lr_ay']],mx=.85,h='<div class="lrcomp"><div></div><div class="lh">MYB</div><div class="lh">AY</div><div class="lh">ΔPY</div><div class="lh">ΔMYB</div>';mets.forEach(([lab,k])=>{let m=q.myb[k]||0,a=q.ay[k]||0,l=q.ly[k]||0,d1=a-l,d2=a-m,cl=x=>Math.abs(x)<.0005?'neu':x<0?'good':'bad';h+=`<div class="ll">${lab}</div><div class="barc"><div class="bar myb" style="width:${Math.max(1,m/mx*100)}%"></div><span class="bv">${pct(m)}</span></div><div class="barc"><div class="bar ay" style="width:${Math.max(1,a/mx*100)}%"></div><span class="bv">${pct(a)}</span></div><div><span class="delta ${cl(d1)}">${ds(d1*100,true)}</span></div><div><span class="delta ${cl(d2)}">${ds(d2*100,true)}</span></div>`});return h+'</div>'}
function lrBridge(name){let q=L[name],start=q.ly.lr_cy*100,end=q.ay.lr_cy*100,prem=(q.ly.avg_premium/q.ay.avg_premium-1)*q.ly.lr_ff*100,burn=(q.ay.lr_ff-q.ly.lr_ff)*100-prem,ib=(q.ay.ibnr-q.ly.ibnr)*100,other=end-start-prem-burn-ib,v=[start,prem,burn,ib,other,end],cu=[start,start+prem,start+prem+burn,start+prem+burn+ib,end,end],lo=Math.min(...cu)-3,hi=Math.max(...cu)+3,Y=x=>265-(x-lo)/(hi-lo)*190,X=[45,185,325,465,605,745],labs=['LR CY 25','Avg Premium','Burning Cost','IBNR','Other','LR CY 26'],g='';v.forEach((z,i)=>{if(i==0||i==5){let hh=265-Y(z);g+=`<rect x="${X[i]}" y="${Y(z)}" width="70" height="${hh}" rx="8" fill="#333"/><text x="${X[i]+35}" y="${Y(z)-8}" text-anchor="middle">${nf(z,1)}</text>`}else{let bef=cu[i-1],aft=cu[i],yy=Y(Math.max(bef,aft)),hh=Math.max(3,Math.abs(Y(bef)-Y(aft))),c=z<=0?'#79be7b':'#ed9191';g+=`<rect x="${X[i]}" y="${yy}" width="70" height="${hh}" fill="${c}"/><text x="${X[i]+35}" y="${yy-8}" text-anchor="middle">${ds(z)}</text>`}g+=`<text x="${X[i]+35}" y="295" text-anchor="middle" font-size="11">${labs[i]}</text>`});return `<svg viewBox="0 0 860 310">${g}</svg>`}
function lossView(){return `<div class="controls"><b>Portfolio / Brand</b><select id="lrSel">${Object.keys(L).map(x=>`<option>${x}</option>`).join('')}</select></div><div id="lrBody"></div>`}function renderLR(){let n=document.getElementById('lrSel').value;document.getElementById('lrBody').innerHTML=`<div class="card"><h3>Loss Ratio Comparative · ${n}</h3><p class="cap">MYB vs AY, with variation against prior year and MYB</p>${lrComp(n)}</div><div class="card section"><h3>Bridge of Loss Ratio CY vs LY · ${n}</h3>${lrBridge(n)}</div>`}
function fLR(){return `<h2 class="title">Frequency & Loss Ratio</h2><p class="lead">Detailed frequency from Frequency × Severity and macro LR from Claims Drivers</p><div class="subtabs"><button class="stab on" data-s="freq">Frequency</button><button class="stab" data-s="lr">Loss Ratio</button></div><div id="freq" class="subpane on">${freqView()}</div><div id="lr" class="subpane">${lossView()}</div>`}
function pages(){return [['Executive Summary',`<h2 class="title">Executive Summary</h2><div class="card">${sem()}</div>`],['Motor Insurance Portfolio',`<h2 class="title">Motor Insurance Portfolio</h2><div class="note">Macro portfolio view from Claims Drivers October.</div>${sem()}`],['Commercial Indicators',`<h2 class="title">Commercial Indicators</h2>${sem()}`],['Renewals',`<h2 class="title">Renewals</h2><div class="note">Detailed source: Frequency × Severity September.</div><div class="card scroll">${freqView()}</div>`],['Premiums & Costs',`<h2 class="title">Premiums & Costs</h2><div class="note">Average Cost macro uses Average Cost f/f.</div>${sem()}`],['Frequency & Loss Ratio',fLR()],['Actions',`<h2 class="title">Actions</h2><div class="grid3">${B.slice(1).map(b=>`<div class="card action"><h3>${BL[b]}</h3><p>LR CY ${pct(M[b].ay.lr_cy)} · Portfolio ${pol(M[b].ay.portfolio)}</p></div>`).join('')}</div>`],['Appendix',`<h2 class="title">Appendix</h2><div class="card"><p>Claims Drivers October: macro and loss ratio comparative for Particular, SD, Emp, Frotas, CL, AGS ND, AGS, OCS and Non Life.</p><p>Frequency × Severity September: detailed frequency by brand, business type and coverage.</p></div>`]]}
let ps=pages(),t=document.getElementById('tabs'),m=document.getElementById('main');t.innerHTML=ps.map((p,i)=>`<button class="tab ${i?'':'on'}" data-i="${i}">${p[0]}</button>`).join('');m.innerHTML=ps.map((p,i)=>`<section class="pane ${i?'':'on'}">${p[1]}</section>`).join('');function activate(i){t.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));m.querySelectorAll('.pane').forEach(x=>x.classList.remove('on'));t.children[i].classList.add('on');m.children[i].classList.add('on');if(i==5){document.getElementById('freqSeg').onchange=renderFreq;document.getElementById('freqCov').onchange=renderFreq;document.getElementById('lrSel').onchange=renderLR;document.querySelectorAll('.stab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.stab,.subpane').forEach(x=>x.classList.remove('on'));b.classList.add('on');document.getElementById(b.dataset.s).classList.add('on');if(b.dataset.s==='lr')renderLR()});renderFreq();renderLR()}}t.querySelectorAll('button').forEach(b=>b.onclick=()=>activate(+b.dataset.i));
</script></body></html>
