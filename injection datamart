# ============================================================
# core_datamart (Desc_Company) -> append a dim_brand
# ============================================================

from pyspark.sql import functions as F

catalog_name = "agpt_insurance_dv_catalog"
schema_name = "wkb_bus_operations_claimsmotor"

core_table = f"{catalog_name}.{schema_name}.core_datamart"
dim_table = f"{catalog_name}.{schema_name}.dim_brand"

SOURCE_COL = "Desc_Company"      # coluna do core de onde vêm os valores distintos
DIM_KEY_COL = "brand_details"    # coluna da dim_brand que recebe o valor de Desc_Company

# True = só mostra o que seria acrescentado (não grava). Põe False quando estiver ok.
DRY_RUN = True

# Colunas da dim cujo valor por defeito é o próprio valor da chave
# (igual ao "ELSE brand_detail" do código anterior)
DEFAULT_TO_KEY = ["dsc_brand_detail_en"]

# Regras: se Desc_Company == <valor> então <coluna da dim> = <valor>
# Podes pôr as colunas que quiseres (ex.: Level 2). Valores não listados ficam
# com o defeito (a chave, para DEFAULT_TO_KEY; NULL para as restantes).
#
# Exemplo (preenche com os teus valores e nomes de colunas reais da dim_brand):
# RULES = {
#     "Seguro Direct": {
#         "dsc_brand_detail_en": "Seguro Directo",
#         "dsc_brand": "...",
#         "brand_level": "...",
#     },
#     "Frotas": {
#         "brand_level": "...",
#     },
# }
RULES = {}


# ------------------------------------------------------------
# Validações de configuração
# ------------------------------------------------------------

dim = spark.table(dim_table)
dim_types = {f.name: f.dataType for f in dim.schema.fields}
print(f"Colunas da dim_brand: {list(dim_types)}")

# Resolve nomes sem distinguir maiúsculas/minúsculas (o Spark também não distingue)
dim_lower = {n.lower(): n for n in dim_types}


def resolve(name):
    return dim_lower.get(str(name).lower())


key_real = resolve(DIM_KEY_COL)
if key_real is None:
    raise Exception(
        f"DIM_KEY_COL '{DIM_KEY_COL}' não existe em {dim_table}. "
        f"Colunas disponíveis: {list(dim_types)}"
    )
DIM_KEY_COL = key_real

core_cols = spark.table(core_table).columns
if SOURCE_COL.lower() not in [c.lower() for c in core_cols]:
    raise Exception(
        f"SOURCE_COL '{SOURCE_COL}' não existe em {core_table}. "
        f"Colunas disponíveis: {core_cols}"
    )

RULES = {
    chave: {(resolve(c) or c): v for c, v in regra.items()}
    for chave, regra in RULES.items()
}
rule_cols = sorted({c for regra in RULES.values() for c in regra})
em_falta = [c for c in rule_cols if c not in dim_types]
if em_falta:
    raise Exception(
        f"Colunas nas RULES que não existem na dim_brand: {em_falta}. "
        f"Colunas disponíveis: {list(dim_types)}"
    )

default_cols = [resolve(c) for c in DEFAULT_TO_KEY if resolve(c)]
for c in DEFAULT_TO_KEY:
    if not resolve(c):
        print(f"Aviso: {c} (DEFAULT_TO_KEY) não existe na dim_brand, ignorada.")

target_cols = [c for c in dict.fromkeys(default_cols + rule_cols) if c != DIM_KEY_COL]


# ------------------------------------------------------------
# Valores distintos do core
# ------------------------------------------------------------

df_new = (
    spark.table(core_table)
    .select(F.trim(F.col(f"`{SOURCE_COL}`")).alias(DIM_KEY_COL))
    .where(F.col(f"`{DIM_KEY_COL}`").isNotNull() & (F.col(f"`{DIM_KEY_COL}`") != ""))
    .distinct()
)


def sql_str(v) -> str:
    return "'" + str(v).replace("'", "''") + "'"


def rule_expr(col_name: str):
    whens = [
        f"WHEN `{DIM_KEY_COL}` = {sql_str(chave)} THEN {sql_str(regra[col_name])}"
        for chave, regra in RULES.items()
        if col_name in regra
    ]
    default = f"`{DIM_KEY_COL}`" if col_name in default_cols else "NULL"
    if not whens:
        return F.expr(default)
    return F.expr("CASE " + " ".join(whens) + f" ELSE {default} END")


for c in target_cols:
    df_new = df_new.withColumn(c, rule_expr(c))

# ------------------------------------------------------------
# Só os que ainda não existem na dim
# ------------------------------------------------------------

df_append = df_new.join(
    dim.select(F.col(f"`{DIM_KEY_COL}`")),
    on=DIM_KEY_COL,
    how="left_anti",
)

# Só colunas calculadas aqui (as restantes da dim ficam NULL/default), com o tipo da dim
df_append = df_append.select(
    *[F.col(f"`{c}`").cast(dim_types[c]).alias(c) for c in [DIM_KEY_COL] + target_cols]
)

n_new = df_append.count()
print(f"\nNovos registos a acrescentar: {n_new:,}")
display(df_append.orderBy(DIM_KEY_COL))

if n_new == 0:
    print("Nada a acrescentar.")
elif DRY_RUN:
    print("DRY_RUN ativo: nada foi gravado. Põe DRY_RUN = False para acrescentar.")
else:
    (
        df_append.write
        .format("delta")
        .mode("append")
        .saveAsTable(dim_table)
    )
    print(f"Acrescentados {n_new:,} registos a {dim_table}.")
