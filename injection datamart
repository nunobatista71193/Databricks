def to_local_path(path: str) -> str:
    """Converte dbfs:/Volumes/... para /Volumes/... (FUSE)."""
    if path.startswith("dbfs:"):
        return path[len("dbfs:"):]
    return path


def sanitize_column_name(name: str) -> str:
    """Remove/substitui caracteres inválidos para nomes de colunas Delta."""

    novo_nome = str(name).strip()
    novo_nome = re.sub(r"[ ,;{}()\n\t=]", "_", novo_nome)

    substituicoes = {
        "º": "o",
        "ª": "a",
        "%": "pct",
        "/": "_",
        "\\": "_",
        "#": "num",
        "€": "eur",
        "$": "usd",
        "`": "",
    }
    for original, substituto in substituicoes.items():
        novo_nome = novo_nome.replace(original, substituto)

    novo_nome = re.sub(r"_+", "_", novo_nome)
    novo_nome = novo_nome.strip("_")

    if not novo_nome:
        novo_nome = "coluna_sem_nome"

    return novo_nome


def sanitize_dataframe_columns(spark_df):
    """Aplica sanitize_column_name e evita nomes duplicados
    (case-insensitive, como o Delta).

    Usa toDF (renomeia por posição), que não tem problemas com
    pontos nos nomes das colunas, ao contrário de withColumnRenamed.
    """

    nomes_originais = spark_df.columns
    nomes_novos = []
    contagem = {}

    for nome in nomes_originais:
        nome_limpo = sanitize_column_name(nome)
        chave = nome_limpo.lower()

        if chave in contagem:
            contagem[chave] += 1
            nome_limpo = f"{nome_limpo}_{contagem[chave]}"
            # garante que o novo nome também não colide
            while nome_limpo.lower() in contagem:
                contagem[chave] += 1
                nome_limpo = f"{sanitize_column_name(nome)}_{contagem[chave]}"
            contagem[nome_limpo.lower()] = 0
        else:
            contagem[chave] = 0

        nomes_novos.append(nome_limpo)

    return spark_df.toDF(*nomes_novos)


def cast_all_columns_to_string(spark_df):
    """Garante schema raw estável: todas as colunas de negócio em STRING.

    Um único select com backticks: aguenta pontos/hífenes nos nomes
    e gera um plano muito mais leve que centenas de withColumn.
    """
    return spark_df.select(
        *[col(f"`{c}`").cast(StringType()).alias(c) for c in spark_df.columns]
    )


def detect_delimiter_and_encoding(local_path: str):
    """Detecta ; ou , e o encoding mais adequado."""
    encodings = ["utf-8-sig", "latin1", "cp1252", "utf-8"]

    for enc in encodings:
        try:
            with open(local_path, "r", encoding=enc, newline="") as f:
                sample = f.read(8192)
            if not sample:
                continue

            try:
                dialect = csv.Sniffer().sniff(sample, delimiters=";,|\t")
                print(f"Delimitador detectado: {dialect.delimiter!r} (encoding={enc})")
                return dialect.delimiter, enc
            except Exception:
                if sample.count(";") >= sample.count(","):
                    print(f"Delimitador assumido: ';' (encoding={enc})")
                    return ";", enc
                print(f"Delimitador assumido: ',' (encoding={enc})")
                return ",", enc
        except Exception:
            continue

    print("Delimitador/encoding por omissão: ';' / latin1")
    return ";", "latin1"


def read_csv_spark(volume_path: str, delimiter: str, encoding: str):
    path = to_local_path(volume_path)

    return (
        spark.read
        .format("csv")
        .option("header", "true")
        .option("inferSchema", "false")   # CRÍTICO: não inferir INT/DOUBLE
        .option("delimiter", delimiter)
        .option("encoding", encoding)
        .option("multiLine", "true")
        .option("escape", '"')
        .option("quote", '"')
        .option("mode", "PERMISSIVE")
        .load(path)
    )


def read_csv_pandas(local_path: str, delimiter: str):
    last_err = None
    encodings = ["utf-8-sig", "latin1", "cp1252", "utf-8"]

    for enc in encodings:
        try:
            pdf = pd.read_csv(
                local_path,
                sep=delimiter,
                encoding=enc,
                dtype=str,
                keep_default_na=False
            )
            print(f"pandas.read_csv OK (encoding={enc}, sep={delimiter!r})")
            return pdf
        except Exception as e:
            last_err = e
            print(f"pandas.read_csv falhou encoding={enc}: {e}")

    raise Exception(f"Impossível ler CSV. Último erro: {last_err}")


def read_csv_robust(volume_path: str, file_name: str):
    """Tenta Spark no Volume; se falhar, pandas no caminho FUSE."""
    local_path = to_local_path(volume_path)

    if not os.path.exists(local_path):
        raise FileNotFoundError(f"Ficheiro não encontrado: {local_path}")

    size = os.path.getsize(local_path)
    print(f"Ficheiro: {local_path} ({size:,} bytes)")

    if size == 0:
        raise ValueError(f"Ficheiro vazio: {file_name}")

    delimiter, encoding = detect_delimiter_and_encoding(local_path)

    try:
        df = read_csv_spark(volume_path, delimiter, encoding)
        df.limit(1).count()
        print(f"Spark CSV OK (sep={delimiter!r}, encoding={encoding})")
        return df
    except Exception as e:
        print(f"Spark CSV falhou: {str(e)[:500]}")

    pdf = read_csv_pandas(local_path, delimiter)

    print(f"Registos pandas: {len(pdf):,}")

    if len(pdf) == 0:
        raise ValueError(f"CSV sem linhas de dados: {file_name}")

    return spark.createDataFrame(pdf)


