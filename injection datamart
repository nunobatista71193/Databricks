from pyspark.sql.functions import col, expr
from datetime import datetime

catalog_name = "agpt_insurance_dv_catalog"
schema_name = "wkb_bus_operations_claimsmotor"
table_name = "core_datamart"
source_table = f"{catalog_name}.{schema_name}.raw_datamart"

ingestion_columns = ["source_file", "período", "marca", "load_timestamp"]

# 1. Amostra de 1000 linhas onde Id_Policy está preenchido
print("A carregar amostra de 1000 linhas...")
sample_df = (
    spark.table(source_table)
    .filter(col("AC_Policy").isNotNull() & (col("AC_Policy") != ""))
    .limit(1000)
)

sample_rows = [row.asDict() for row in sample_df.collect()]
print(f"Amostra carregada: {len(sample_rows)} linhas")

def is_date(value):
    if value is None or not isinstance(value, str):
        return False
    value = str(value).strip()
    if len(value) < 8:
        return False
    for fmt in ("%Y-%m-%d", "%d/%m/%Y", "%Y/%m/%d", "%d-%m-%Y", "%Y%m%d"):
        try:
            datetime.strptime(value[:10], fmt)
            return True
        except:
            continue
    return False

def is_numeric(value):
    if value is None:
        return False
    if isinstance(value, (int, float)):
        return True
    if isinstance(value, str):
        try:
            float(str(value).strip().replace(",", "."))
            return True
        except:
            return False
    return False

def has_decimal(value):
    if value is None:
        return False
    s = str(value)
    return "." in s or "," in s

def infer_type(col_name, rows):
    # Força decimal(18,2) em todas as colunas que começam por Amt_
    if col_name.startswith("Amt_"):
        return "decimal(18,2)"

    values = [r.get(col_name) for r in rows if r.get(col_name) is not None]
    if not values:
        return "string"

    total = len(values)
    date_count = sum(1 for v in values if is_date(v))
    numeric_count = sum(1 for v in values if is_numeric(v))
    decimal_count = sum(1 for v in values if is_numeric(v) and has_decimal(v))

    # Data
    if total > 0 and date_count / total > 0.85:
        return "date"

    # Numérico
    if total > 0 and numeric_count / total > 0.95:
        if numeric_count > 0 and decimal_count / numeric_count > 0.05:
            return "decimal(18,2)"
        else:
            max_abs = 0
            for v in values:
                try:
                    n = abs(float(str(v).replace(",", ".")))
                    if n > max_abs:
                        max_abs = n
                except:
                    pass
            if max_abs < 2_147_483_647:
                return "int"
            else:
                return "bigint"

    # Boolean
    bool_set = {"true", "false", "1", "0", "s", "n", "sim", "nao", "yes", "no"}
    bool_count = sum(1 for v in values if str(v).lower().strip() in bool_set)
    if total > 0 and bool_count / total > 0.95:
        return "boolean"

    return "string"

# 2. Infere tipos
print("A inferir tipos...")
type_map = {}
for col_name in sample_df.columns:
    type_map[col_name] = infer_type(col_name, sample_rows)

# 3. Aplica try_cast
df = spark.table(source_table)

for col_name, spark_type in type_map.items():
    if col_name in df.columns and spark_type != "string":
        df = df.withColumn(col_name, expr(f"try_cast(`{col_name}` as {spark_type})"))

# 4. Remove colunas de ingestão
cols_to_drop = [c for c in ingestion_columns if c in df.columns]
if cols_to_drop:
    df = df.drop(*cols_to_drop)
    print(f"Colunas de ingestão removidas: {cols_to_drop}")

# 5. Escreve a tabela
df.write \
  .format("delta") \
  .mode("overwrite") \
  .option("overwriteSchema", "true") \
  .saveAsTable(f"{catalog_name}.{schema_name}.{table_name}")

print(f"Tabela criada com sucesso. Total de colunas: {len(df.columns)}")
