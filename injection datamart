from pyspark.sql import functions as F

catalog_name = "agpt_insurance_dv_catalog"
schema_name = "wkb_bus_operations_claimsmotor"

# Marcas existentes no datamart
df_new = (
    spark.table(f"{catalog_name}.{schema_name}.core_datamart")
    .select("brand_details")
    .distinct()
    .withColumnRenamed("brand_details", "brand_detail")
    .withColumn(
        "dsc_brand_detail_en",
        F.expr("""
            CASE
                WHEN brand_detail = 'OCS' THEN 'Ocidental'
                WHEN brand_detail = 'Frotas' THEN 'Fleets'
                WHEN brand_detail = 'Emp' THEN 'Commercial'
                WHEN brand_detail = 'Particular' THEN 'Private Line'
                WHEN brand_detail = 'SD' THEN 'Seguro Directo'
                WHEN brand_detail = 'Non Life' THEN 'Global'
                WHEN brand_detail = 'CL' THEN 'Commercial Line'
                ELSE brand_detail
            END
        """)
    )
)

# Dimensão atual
df_dim = spark.table(f"{catalog_name}.{schema_name}.dim_brand")

# Apenas marcas que ainda não existem
df_append = df_new.join(
    df_dim.select("brand_detail"),
    on="brand_detail",
    how="left_anti"
)

# Append
df_append.write \
    .format("delta") \
    .mode("append") \
    .saveAsTable(f"{catalog_name}.{schema_name}.dim_brand")
